APP_ENV=dev
HTTP_ADDR=:8080

DATABASE_URL=postgres://cozy:cozy@localhost:5432/cozy?sslmode=disable

JWT_SECRET=change-me-in-prod

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cozy
MINIO_SECRET_KEY=cozy12345
MINIO_BUCKET=cozy-media
MINIO_USE_SSL=false

# Host browsers (admin, site) and the mobile app use to view photos via
# plain public URLs. In prod, MINIO_ENDPOINT is an internal Docker hostname
# (see docker-compose.prod.yml) that only the backend container can resolve,
# so these must point at the Caddy-fronted media host — otherwise no
# product photo loads. On the staging VPS:
#   MINIO_PUBLIC_ENDPOINT=media.cozy.erpsystemsales.com
#   MINIO_PUBLIC_USE_SSL=true
# (no port — Caddy serves it on 443, see docker/Caddyfile). Defaults to
# MINIO_ENDPOINT/MINIO_USE_SSL, which is correct for local dev.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false

BAKAI_WEBHOOK_TOKEN=change-me

# smspro.nikita.kg -> Личный кабинет -> вкладка "СЕРВИС OTP" -> API-ключ
NIKITA_API_KEY=change-me

# Локальная разработка без реального SMS-провайдера: код всегда "0000",
# SMS не отправляется. НИКОГДА не включать в проде (сервер откажется
# стартовать, если одновременно SMS_MOCK_OTP=true и APP_ENV=prod).
SMS_MOCK_OTP=false

# Внешний адрес сайта — для ссылок на заказ в админке в Telegram-уведомлениях.
# Пусто — сообщение уходит без ссылки. Staging: https://cozy.erpsystemsales.com
PUBLIC_BASE_URL=

# Push-уведомления покупателю о смене статуса заказа (Firebase Cloud Messaging,
# HTTP v1). Firebase console -> Project settings -> Service accounts ->
# Generate new private key -> JSON-файл. Пусто — push только пишется в лог.
# В docker-compose.prod.yml папка ./secrets смонтирована в /secrets (read-only):
#   FCM_CREDENTIALS_FILE=/secrets/firebase-service-account.json
# FCM_PROJECT_ID необязателен (по умолчанию project_id из JSON-ключа).
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=

# Уведомления персоналу о новом заказе в Telegram. Бот — через @BotFather,
# добавить его в группу персонала; TELEGRAM_CHAT_ID — id этой группы
# (для групп отрицательное число, например -1001234567890).
# Любая из двух пустая — уведомления только пишутся в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GET /api/v1/app/config — версии мобильного приложения: ниже min_version
# приложение требует обновиться, ниже latest_version — предлагает.
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=
# Необязательно: логи и лимиты (значения по умолчанию — в README,
# «Эксплуатация»). LOG_FORMAT=json — одна JSON-строка на запись.
# LOG_FORMAT=text
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=60s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_IDLE_TIMEOUT=120s
# HTTP_SHUTDOWN_TIMEOUT=10s
