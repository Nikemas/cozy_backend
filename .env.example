APP_ENV=dev
HTTP_ADDR=:8080

DATABASE_URL=postgres://cozy:cozy@localhost:5432/cozy?sslmode=disable

JWT_SECRET=change-me-in-prod

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cozy
MINIO_SECRET_KEY=cozy12345
MINIO_BUCKET=cozy-media
MINIO_USE_SSL=false

# Host the ADMIN'S BROWSER (and the mobile app) uses to upload/view photos
# via presigned URLs. In prod, MINIO_ENDPOINT is an internal Docker hostname
# (see docker-compose.prod.yml) that only the backend container can resolve,
# so these must point at the Caddy-fronted media host — otherwise photo
# upload fails with "Не удалось загрузить фото". On the staging VPS:
#   MINIO_PUBLIC_ENDPOINT=media.cozy.erpsystemsales.com
#   MINIO_PUBLIC_USE_SSL=true
# (no port — Caddy serves it on 443, see docker/Caddyfile). Defaults to
# MINIO_ENDPOINT/MINIO_USE_SSL, which is correct for local dev.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false

BAKAI_WEBHOOK_TOKEN=change-me

# smspro.nikita.kg -> Личный кабинет -> вкладка "СЕРВИС OTP" -> API-ключ
NIKITA_API_KEY=change-me

# Локальная разработка без реального SMS-провайдера: код всегда "0000",
# SMS не отправляется. НИКОГДА не включать в проде (сервер откажется
# стартовать, если одновременно SMS_MOCK_OTP=true и APP_ENV=prod).
SMS_MOCK_OTP=false
