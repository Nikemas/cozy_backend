# TEST PHASE: no domain pointed at this server yet, so we serve over the
# raw IP with a self-signed cert (Let's Encrypt can't issue for a bare IP).
# Browsers will show a certificate warning — expected, click through for
# testing. Staff admin-panel sessions set a `Secure` cookie, so plain HTTP
# won't work at all here; this is the minimum needed for login to function.
#
# Once the client's domain DNS A-record points at this server, replace the
# site address below with the real domain(s), e.g.:
#
#   cozy.kg, www.cozy.kg {
#       reverse_proxy backend:8080
#   }
#
# and Caddy will automatically obtain a real Let's Encrypt certificate —
# no self-signed warning, no other changes needed. Update the DEPLOY_HOST
# GitHub secret to match once that happens.

{
	# Clients connecting to a bare IP (no domain) typically send no SNI at
	# all in the TLS ClientHello — without this, Caddy can't pick which
	# certificate to present and the handshake fails with a TLS "internal
	# error" alert. Remove this global block once the real domain is in
	# place below (SNI-based selection works normally with a hostname).
	default_sni 95.215.244.199
}

95.215.244.199 {
	tls internal
	reverse_proxy backend:8080
}
