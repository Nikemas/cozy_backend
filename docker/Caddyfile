# Hostnames served by this VPS (95.215.244.199).
#
# STAGING (active now): cozy.erpsystemsales.com — a subdomain of our own
# erpsystemsales.com zone (DNS on Cloudflare), used while the client has not
# yet handed over cozy.kg. Caddy obtains a real Let's Encrypt cert for it, so
# the site, the admin panel (Secure cookies) and the mobile app (iOS ATS
# rejects self-signed certs) all work without warnings. Keep this host after
# cozy.kg goes live — it doubles as a permanent staging environment.
#
# MEDIA: media.cozy.erpsystemsales.com fronts MinIO (port 9000 inside the
# compose network) so public photo URLs are HTTPS on the same cert
# scheme — a plain http://host:9000 URL would be blocked as mixed content on
# an HTTPS page. The backend must build URLs for exactly this host:
# MINIO_PUBLIC_ENDPOINT=media.cozy.erpsystemsales.com, MINIO_PUBLIC_USE_SSL=true
# in the server's .env. reverse_proxy passes the browser's Host header
# through unchanged, which is what MinIO's SigV4 check needs.
#
# Cloudflare DNS records to create (both "DNS only" / grey cloud is the
# simplest — no Cloudflare SSL-mode or upload-size limits to think about):
#   A  cozy        -> 95.215.244.199
#   A  media.cozy  -> 95.215.244.199
# If you do proxy them (orange cloud), set the zone's SSL/TLS mode to
# "Full (strict)"; "Flexible" talks plain HTTP to the origin and loops with
# Caddy's HTTP->HTTPS redirect.
#
# PRODUCTION (pending): cozy.kg block is commented out until the client
# actually points its DNS here — an unreachable hostname makes Caddy retry
# ACME issuance forever and spam the logs. To enable: uncomment the block,
# nothing else changes.
#
# The bare-IP block is kept as a fallback (self-signed cert, browser
# warning expected). Caddy routes by SNI, so it only serves connections
# that name the IP itself.

{
	# Clients connecting to a bare IP (no domain) typically send no SNI at
	# all in the TLS ClientHello — without this, Caddy can't pick which
	# certificate to present and the handshake fails with a TLS "internal
	# error" alert. Only affects the bare-IP fallback block below; SNI-based
	# selection for real hostnames works normally regardless.
	default_sni 95.215.244.199
}

# --- staging: site + API + admin ------------------------------------------
#
# encode: gzip/zstd-compress HTML, JSON, CSS, JS, SVG and XML responses from
# the backend (Caddy's default content-type list skips already-compressed
# images). Done here rather than in Go so the backend stays simple and
# compression is handled by the TLS terminator. Not on the media block:
# product photos are JPEG/PNG/WebP and gain nothing.
cozy.erpsystemsales.com {
	encode zstd gzip
	reverse_proxy backend:8080
}

# --- staging: media (MinIO S3 API, public photo GETs from browser/app) -----
media.cozy.erpsystemsales.com {
	reverse_proxy minio:9000
}

# --- production: enable once the client's DNS points at this VPS ----------
# cozy.kg, www.cozy.kg {
# 	encode zstd gzip
# 	reverse_proxy backend:8080
# }

# --- bare-IP fallback -------------------------------------------------------
95.215.244.199 {
	tls internal
	encode zstd gzip
	reverse_proxy backend:8080
}
