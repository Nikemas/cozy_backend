# Client's domain (confirmed 2026-09-17): cozy.kg, DNS-managed on
# Cloudflare, A-record already pointed at this VPS. Caddy gets a real
# Let's Encrypt cert for it automatically — no self-signed warning.
#
# Cloudflare note: the zone is proxied (orange cloud), so browsers hit
# Cloudflare's edge, not this box, directly. The ACME HTTP-01 challenge
# still reaches Caddy fine (Cloudflare passes /.well-known/acme-challenge/
# through), but Cloudflare's own SSL/TLS mode (dashboard -> SSL/TLS)
# matters for the Cloudflare<->origin leg: "Full" or "Full (strict)" is
# correct here now that Caddy presents a real cert; "Flexible" talks plain
# HTTP to the origin and can loop with Caddy's HTTP->HTTPS redirect.
#
# The bare-IP block below is kept as a fallback (e.g. if Cloudflare/DNS
# ever misbehaves) — harmless to keep alongside the domain block, Caddy
# routes by SNI and this only serves connections that name the IP itself.

{
	# Clients connecting to a bare IP (no domain) typically send no SNI at
	# all in the TLS ClientHello — without this, Caddy can't pick which
	# certificate to present and the handshake fails with a TLS "internal
	# error" alert. Only affects the bare-IP fallback block below; SNI-based
	# selection for cozy.kg works normally regardless.
	default_sni 95.215.244.199
}

cozy.kg, www.cozy.kg {
	reverse_proxy backend:8080
}

95.215.244.199 {
	tls internal
	reverse_proxy backend:8080
}
