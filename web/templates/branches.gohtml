{{define "content"}}
<div class="branches-screen">
  <h1 class="screen-title">{{t "branches.title"}}</h1>

  {{if .Data.Empty}}
  <div class="orders-empty">
    <i class="ti ti-map-pin-off orders-empty__icon" aria-hidden="true"></i>
    <div class="muted">{{t "branches.empty"}}</div>
  </div>
  {{else}}
  <div class="branches-layout">
    <div class="branches-map" id="branches-map">
      <iframe id="branches-map-frame" title="{{t "branches.title"}}" src="{{(index .Data.Cards 0).EmbedURL}}"
              loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>

    <div class="branches-list">
      {{range .Data.Cards}}
      <div class="branch-card{{if .FirstInSet}} branch-card--active{{end}}" data-branch="{{.Index}}" data-embed="{{.EmbedURL}}" tabindex="0">
        <div class="branch-card__row">
          <div class="branch-card__badge">{{.Number}}</div>
          <div class="branch-card__info">
            <div class="branch-card__name">{{.Name}}</div>
            <div class="branch-card__address">{{.City}}, {{.Address}}</div>
            {{if .Hours}}<div class="branch-card__address"><i class="ti ti-clock" aria-hidden="true"></i> {{.Hours}}</div>{{end}}
          </div>
        </div>
        <div class="branch-card__footer">
          <a class="branch-card__route" href="{{.RouteURL}}" target="_blank" rel="noopener noreferrer">
            <i class="ti ti-navigation" aria-hidden="true"></i> {{t "branches.route"}}
          </a>
        </div>
      </div>
      {{end}}
    </div>
  </div>
  {{end}}
</div>

<script>
  // Pure client-side card selection: highlights the card and points the
  // Google Maps iframe at that branch.
  (function () {
    var frame = document.getElementById("branches-map-frame");
    if (!frame) return;

    function select(card) {
      document.querySelectorAll(".branch-card").forEach(function (el) {
        el.classList.toggle("branch-card--active", el === card);
      });
      if (card.dataset.embed && frame.src !== card.dataset.embed) frame.src = card.dataset.embed;
    }

    document.querySelectorAll(".branch-card").forEach(function (el) {
      el.addEventListener("click", function () { select(el); });
      el.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(el); }
      });
    });
  })();
</script>
{{end}}
