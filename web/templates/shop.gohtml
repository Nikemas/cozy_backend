{{/* shop screen (COZY_WEB_DESIGN.md §3.1) — Task 2.
     "_shop_results" is a separate named block (not just a div in
     "content") so every HTMX filter/search/pagination control can target
     it with hx-select="#shop-results" and get back just this fragment
     from the very same full-page response a plain browser request would
     render — see internal/web/catalog_view.go's doc comment. */}}
{{define "content"}}
<div>
  {{template "_shop_results" .}}
</div>
<script>
  // Escape closes the quick-buy modal. Lives here (rendered once with the
  // full page) rather than inside _quickbuy_modal, which is re-rendered
  // on every size/color pick — an inline listener there would stack a
  // new one on each swap instead of just running once.
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    var slot = document.getElementById("quickbuy-slot");
    if (slot) slot.innerHTML = "";
  });
</script>
{{end}}

{{define "_shop_results"}}
{{$d := .Data}}
<div id="shop-results">
  {{if $d.ShowBanner}}{{with $d.Banner}}
  {{/* Editable at /admin/banner (internal/web/banner_view.go). Colors are
       validated #RRGGBB; they only set custom properties site.css reads,
       so an empty value keeps the stylesheet default. */}}
  <div class="shop-banner{{if .CustomInk}} shop-banner--ink{{end}}"
       {{- if or .BgColor .TextColor .BgImageURL}} style="{{if .BgColor}}--banner-bg: {{.BgColor}};{{end}}{{if .TextColor}} --banner-ink: {{.TextColor}};{{end}}{{if .BgImageURL}} background-image: url({{.BgImageURL}});{{end}}"{{end}}>
    <div class="shop-banner__text">
      {{if .Eyebrow}}<div class="shop-banner__eyebrow">{{.Eyebrow}}</div>{{end}}
      <div class="shop-banner__title">{{.Title}}</div>
      {{if .ButtonText}}<a class="btn btn--primary shop-banner__btn" href="{{.ButtonHref}}">{{.ButtonText}}</a>{{end}}
    </div>
    {{if .ImageURL}}
    <img class="shop-banner__img" src="{{.ImageURL}}" alt="{{.Title}}" width="240" height="160" loading="eager" fetchpriority="high" decoding="async">
    {{else}}
    <svg width="130" height="86" viewBox="0 0 100 60" aria-hidden="true">
      <path d="M8 42 Q8 30 22 28 L40 24 Q52 20 64 24 L82 30 Q92 33 92 42 L92 46 L8 46 Z" fill="#FFFFFF" stroke="var(--cozy-accent)" stroke-width="2"/>
      <path d="M20 33 L45 33" stroke="var(--cozy-accent)" stroke-width="3" stroke-linecap="round"/>
    </svg>
    {{end}}
  </div>
  {{end}}{{end}}
  <h1 class="shop-title">{{if $d.CategoryName}}{{$d.CategoryName}}{{else if $d.Query}}{{t "shop.search_results"}} «{{$d.Query}}»{{else}}{{t "shop.heading"}}{{end}}</h1>
  <div class="shop-toolbar" id="catalog">
    <nav class="shop-chips" aria-label="{{t "sidebar.categories"}}">
      {{range $d.Categories}}
      <a class="chip chip--tab{{if .Active}} chip--tab--active{{end}}"
         href="{{.Href}}"{{if .Active}} aria-current="page"{{end}}
         hx-get="{{.Href}}" hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true"
         hx-select-oob="#aside-categories,#shop-filters"
         hx-include="#shop-q, #shop-filters, #shop-sort">{{.Label}}</a>
      {{end}}
    </nav>
    <div class="shop-toolbar__right">
      <div class="shop-count" role="status">{{$d.Total}} {{plural $d.Total "shop.results"}}</div>
      <label class="shop-sort">
        <span class="visually-hidden">{{t "shop.sort.label"}}</span>
        <select id="shop-sort" name="sort"
                hx-get="{{$d.BasePath}}" hx-trigger="change"
                hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true"
                hx-include="#shop-q, #shop-filters">
          {{range $d.SortOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}
        </select>
      </label>
    </div>
  </div>

  {{if $d.NoResults}}
  <div class="shop-empty">
    <i class="ti ti-mood-empty" aria-hidden="true"></i>
    <div>{{t "shop.empty"}}</div>
    {{if or $d.HasFilters $d.Query}}<a class="btn btn--ghost shop-empty__reset" href="{{$d.BasePath}}">{{t "sidebar.reset"}}</a>{{end}}
  </div>
  {{else}}
  <div class="shop-grid">
    {{range $d.Products}}
    <div class="product-card">
      <button class="product-card__fav" type="button" aria-label="{{t "product.add_to_favorites"}}: {{.Name}}"
              hx-post="/favorites/{{.ID}}" hx-target="#toast-slot" hx-swap="innerHTML">
        <i class="ti ti-heart" aria-hidden="true"></i>
      </button>
      <a class="product-card__link" href="{{.DetailURL}}">
        <div class="product-card__thumb">
          {{if .HasPhoto}}
          <img src="{{.PhotoURL}}" alt="{{.Name}}" width="400" height="400" loading="lazy" decoding="async">
          {{else}}
          <svg width="110" height="66" viewBox="0 0 100 60" aria-hidden="true">
            <path d="M8 42 Q8 30 22 28 L40 24 Q52 20 64 24 L82 30 Q92 33 92 42 L92 46 L8 46 Z" fill="#FFFFFF" stroke="var(--cozy-accent-aa)" stroke-width="2"/>
            <path d="M20 33 L45 33" stroke="var(--cozy-accent-aa)" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          {{end}}
        </div>
        {{if .Brand}}<div class="product-card__brand">{{.Brand}}</div>{{end}}
        <div class="product-card__name">{{.Name}}</div>
        <div class="product-card__price">{{if .PriceFrom}}{{printf (t "shop.price_from") .PriceText}}{{else}}{{.PriceText}}{{end}}</div>
      </a>
      {{/* Quick-buy (COZY_WEB_DESIGN.md §3.1, ported from the mobile
           design's "Быстрая покупка"): opens _quickbuy_modal below in
           #quickbuy-slot instead of leaving the shop screen. */}}
      <button class="product-card__buy" type="button" aria-label="{{t "shop.quick_buy"}}: {{.Name}}"
              hx-get="/quickbuy/{{.ID}}" hx-target="#quickbuy-slot" hx-swap="innerHTML">
        <i class="ti ti-shopping-cart-filled" aria-hidden="true"></i> {{t "shop.quick_buy"}}
      </button>
    </div>
    {{end}}
  </div>

  {{if or $d.HasPrev $d.HasNext}}
  <div class="shop-pager">
    {{if $d.HasPrev}}
    <a class="shop-pager__link" href="{{$d.PrevHref}}"
       hx-get="{{$d.PrevHref}}" hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true">
      <i class="ti ti-chevron-left" aria-hidden="true"></i> {{t "shop.prev"}}
    </a>
    {{end}}
    <span class="shop-pager__page">{{$d.Page}} / {{$d.TotalPages}}</span>
    {{if $d.HasNext}}
    <a class="shop-pager__link" href="{{$d.NextHref}}"
       hx-get="{{$d.NextHref}}" hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true">
      {{t "shop.next"}} <i class="ti ti-chevron-right" aria-hidden="true"></i>
    </a>
    {{end}}
  </div>
  {{end}}
  {{end}}
</div>
{{end}}

{{/* Quick-buy modal (COZY_WEB_DESIGN.md §3.1) — rendered by
     GET /quickbuy/{id} into #quickbuy-slot (see layout.gohtml) and
     re-rendered in place on every size/color pick; see
     internal/web/quickbuy_handlers.go and catalog_view.go's
     buildQuickBuyData. Closing (X, overlay click, Escape) is plain JS —
     no server round trip needed to just empty the mount point. */}}
{{define "_quickbuy_modal"}}
{{$d := .Data}}
<div class="modal-overlay" onclick="document.getElementById('quickbuy-slot').innerHTML=''"></div>
<div class="quickbuy-modal" role="dialog" aria-modal="true" aria-label="{{$d.Name}}">
  <button type="button" class="quickbuy-modal__close" aria-label="{{t "common.close"}}"
          onclick="document.getElementById('quickbuy-slot').innerHTML=''">
    <i class="ti ti-x" aria-hidden="true"></i>
  </button>
  <div class="quickbuy-modal__head">
    <div class="quickbuy-modal__photo">
      {{if $d.HasPhoto}}
      <img src="{{$d.PhotoURL}}" alt="{{$d.Name}}" width="200" height="200">
      {{else}}
      <svg width="70" height="42" viewBox="0 0 100 60" aria-hidden="true">
        <path d="M8 42 Q8 30 22 28 L40 24 Q52 20 64 24 L82 30 Q92 33 92 42 L92 46 L8 46 Z" fill="#FFFFFF" stroke="var(--cozy-accent-aa)" stroke-width="2"/>
      </svg>
      {{end}}
    </div>
    <div class="quickbuy-modal__info">
      {{if $d.Brand}}<div class="quickbuy-modal__brand">{{$d.Brand}}</div>{{end}}
      <div class="quickbuy-modal__name">{{$d.Name}}</div>
      <div class="quickbuy-modal__price">{{$d.PriceText}}</div>
    </div>
  </div>

  {{if $d.Sizes}}
  <div class="product-section-title">{{t "product.size"}}</div>
  <div class="product-options">
    {{range $d.Sizes}}
    <a class="product-option{{if .Selected}} product-option--active{{end}}{{if not .Available}} product-option--unavailable{{end}}"
       href="{{.Href}}"{{if .Selected}} aria-current="true"{{end}}
       hx-get="{{.Href}}" hx-target="#quickbuy-slot" hx-swap="innerHTML">{{.Label}}</a>
    {{end}}
  </div>
  {{end}}

  {{if $d.Colors}}
  <div class="product-section-title">{{t "product.color"}}</div>
  <div class="product-options">
    {{range $d.Colors}}
    <a class="product-option product-option--color{{if .Selected}} product-option--active{{end}}{{if not .Available}} product-option--unavailable{{end}}"
       href="{{.Href}}"{{if .Selected}} aria-current="true"{{end}}
       hx-get="{{.Href}}" hx-target="#quickbuy-slot" hx-swap="innerHTML">{{.Label}}</a>
    {{end}}
  </div>
  {{end}}

  {{if not $d.InStock}}<p class="quickbuy-modal__unavailable" role="status">{{t "product.out_of_stock"}}</p>{{end}}

  <form class="quickbuy-modal__actions">
    <input type="hidden" name="size" value="{{$d.SelectedSize}}">
    <input type="hidden" name="color" value="{{$d.SelectedColor}}">
    <button type="button" class="btn btn--primary quickbuy-modal__order" {{if not $d.InStock}}disabled{{end}}
            hx-post="{{$d.BuyActionURL}}" hx-include="closest form" hx-target="#toast-slot" hx-swap="innerHTML"
            hx-on::after-request="document.getElementById('quickbuy-slot').innerHTML=''">
      {{t "product.buy_now"}} <i class="ti ti-shopping-cart-filled" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn btn--ghost quickbuy-modal__cart" {{if not $d.InStock}}disabled{{end}}
            hx-post="{{$d.CartActionURL}}" hx-include="closest form" hx-target="#toast-slot" hx-swap="innerHTML"
            hx-on::after-request="document.getElementById('quickbuy-slot').innerHTML=''">
      {{t "product.add_to_cart"}} <i class="ti ti-shopping-bag" aria-hidden="true"></i>
    </button>
  </form>
</div>
{{end}}
