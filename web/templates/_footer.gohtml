{{define "_footer"}}
<footer class="footer">
  <div class="footer__inner">
    <span class="footer__rights">{{t "footer.rights"}}</span>
    <nav class="footer__links" aria-label="{{t "footer.nav_label"}}">
      <a href="/about">{{t "screen.page_about.title"}}</a>
      <a href="/delivery">{{t "screen.page_delivery.title"}}</a>
      <a href="/branches">{{t "footer.branches"}}</a>
      <a href="/contacts">{{t "screen.page_contacts.title"}}</a>
      <a href="/terms">{{t "screen.page_terms.title"}}</a>
      <a href="/privacy">{{t "screen.page_privacy.title"}}</a>
      <a href="/account-deletion">{{t "screen.page_account-deletion.title"}}</a>
      <a href="/lang">{{t "screen.lang.title"}}</a>
    </nav>
  </div>
  {{with seller}}{{if .LegalName}}<div class="footer__legal">{{.LegalName}}{{with .TaxID}}. {{t "legal.inn"}} {{.}}{{end}}{{with .LegalAddress}}. {{.}}{{end}}</div>{{end}}{{end}}
</footer>
{{end}}
