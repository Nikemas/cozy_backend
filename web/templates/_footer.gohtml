{{define "_footer"}}
<footer class="footer">
  <div class="footer__inner">
    <span class="footer__rights">{{t "footer.rights"}}</span>
    <nav class="footer__links">
      <a href="/branches">{{t "footer.branches"}}</a>
      <a href="/lang">{{t "screen.lang.title"}}</a>
    </nav>
  </div>
  <div class="footer__legal">{{t "footer.legal"}}</div>
</footer>
{{end}}
