{{define "content"}}
<div class="profile">
  {{if .Authed}}
    <div class="card profile-card">
      <div class="profile-card__avatar"><i class="ti ti-user" aria-hidden="true"></i></div>
      <div class="profile-card__info">
        <div class="profile-card__name">{{if .CustomerName}}{{.CustomerName}}{{else}}{{t "nav.profile"}}{{end}}</div>
        {{if .MaskedPhone}}<div class="profile-card__phone">{{.MaskedPhone}}</div>{{end}}
      </div>
    </div>

    {{/* Only "orders" and "favorites" — the design's 3rd tile ("бонусы")
         is hardcoded fake data with no backing entity in the DB, so it's
         intentionally not rendered (see Task 4 notes in tasks/web-plan.md). */}}
    <div class="profile-stats">
      <a class="profile-stat" href="/orders">
        <div class="profile-stat__value">{{.OrdersCount}}</div>
        <div class="profile-stat__label">{{t "sidebar.orders"}}</div>
      </a>
      <a class="profile-stat" href="/favorites">
        <div class="profile-stat__value">{{.FavCount}}</div>
        <div class="profile-stat__label">{{t "sidebar.favorites"}}</div>
      </a>
    </div>

    <div class="profile-menu">
      <a class="profile-menu__item" href="/orders">
        <i class="ti ti-package" aria-hidden="true"></i> <span>{{t "sidebar.orders"}}</span> <i class="ti ti-chevron-right profile-menu__chevron" aria-hidden="true"></i>
      </a>
      <a class="profile-menu__item" href="/addresses">
        <i class="ti ti-map-pin" aria-hidden="true"></i> <span>{{t "profile.addresses"}}</span> <i class="ti ti-chevron-right profile-menu__chevron" aria-hidden="true"></i>
      </a>
      <a class="profile-menu__item" href="/lang">
        <i class="ti ti-language" aria-hidden="true"></i> <span>{{t "profile.language"}}</span> <i class="ti ti-chevron-right profile-menu__chevron" aria-hidden="true"></i>
      </a>
      <a class="profile-menu__item" href="/contacts">
        <i class="ti ti-headset" aria-hidden="true"></i> <span>{{t "profile.support"}}</span> <i class="ti ti-chevron-right profile-menu__chevron" aria-hidden="true"></i>
      </a>
    </div>

    <form method="post" action="/logout" hx-post="/logout">
      <button type="submit" class="btn btn--danger">{{t "auth.logout"}}</button>
    </form>
  {{else}}
    {{template "_profile_auth" .}}
  {{end}}
</div>
{{end}}
