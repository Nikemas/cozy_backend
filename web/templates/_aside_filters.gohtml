{{define "_aside_filters"}}
<aside class="aside">
  {{if .Authed}}
  <div class="aside__card">
    <div class="aside__account">
      <div class="aside__avatar"><i class="ti ti-user"></i></div>
      <div class="aside__account-info">
        <div class="aside__account-name">{{if .CustomerName}}{{.CustomerName}}{{else}}{{t "nav.profile"}}{{end}}</div>
        <div class="aside__account-phone">{{.MaskedPhone}}</div>
      </div>
    </div>
    <a class="aside__link" href="/orders"><i class="ti ti-package"></i> {{t "sidebar.orders"}} <span class="aside__link-count">{{.OrdersCount}}</span></a>
    <a class="aside__link" href="/favorites"><i class="ti ti-heart"></i> {{t "sidebar.favorites"}} <span class="aside__link-count">{{.FavCount}}</span></a>
  </div>
  {{else}}
  <a class="btn btn--primary aside__login" href="/profile">{{t "sidebar.login"}}</a>
  {{end}}

  <div class="aside__card">
    <div class="aside__title">{{t "sidebar.categories"}}</div>
    {{if eq .Screen "shop"}}
    {{range .Data.Categories}}
    <a class="aside__pill{{if .Active}} aside__pill--active{{end}}"
       href="{{.Href}}"
       hx-get="{{.Href}}" hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true"
       hx-include="#shop-q, #shop-price-max">{{.Label}}</a>
    {{end}}
    {{else}}
    <a class="aside__pill" href="/">{{t "sidebar.category.all"}}</a>
    {{end}}
  </div>

  <div class="aside__card">
    <div class="aside__title">{{t "sidebar.style"}}</div>
    <!-- Not wired: internal/catalog has no "style" concept on
         products/categories (see products/categories migrations) — this
         would need a schema change out of Task 2's scope (it doesn't own
         internal/catalog's tables). Left decorative/disabled rather than
         faking a filter that doesn't do anything. -->
    <div class="aside__chips">
      <span class="chip">Sneakers</span>
      <span class="chip">Boots</span>
      <span class="chip">Casual</span>
    </div>
  </div>

  <div class="aside__card">
    <div class="aside__title">{{t "sidebar.brand"}}</div>
    <!-- Not wired: catalog.ListFilter has no Brand field (only
         category/size/color/price/q/sort/page) and adding one means
         rewriting ProductRepo.List's existing query body, which Task 2
         was told not to do ("не переписывая их тела") while Task D
         concurrently adds admin write methods to the same file. Left
         decorative/disabled — see report deviation. -->
    <label class="aside__checkbox"><input type="checkbox" disabled> Nike</label>
    <label class="aside__checkbox"><input type="checkbox" disabled> Adidas</label>
  </div>

  <div class="aside__card">
    <div class="aside__title">{{t "sidebar.price"}}{{if eq .Screen "shop"}}{{if .Data.PriceMax}} {{.Data.PriceMax}}{{end}}{{end}}</div>
    {{if eq .Screen "shop"}}
    <input type="range" id="shop-price-max" name="price_max" min="1000" max="6000" step="100"
           value="{{if .Data.PriceMax}}{{.Data.PriceMax}}{{else}}6000{{end}}"
           hx-get="{{.Data.BasePath}}" hx-trigger="change"
           hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true"
           hx-include="#shop-q">
    {{else}}
    <input type="range" min="1000" max="6000" step="100" disabled>
    {{end}}
  </div>

  {{if eq .Screen "shop"}}
  <a class="aside__reset" href="/">{{t "sidebar.reset"}}</a>
  {{else}}
  <button class="aside__reset" type="button" disabled>{{t "sidebar.reset"}}</button>
  {{end}}
</aside>
{{end}}
