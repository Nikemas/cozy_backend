{{define "_aside_filters"}}
<aside class="aside">
  {{if .Authed}}
  <div class="aside__card">
    <div class="aside__account">
      <div class="aside__avatar"><i class="ti ti-user"></i></div>
      <div class="aside__account-info">
        <div class="aside__account-name">{{if .CustomerName}}{{.CustomerName}}{{else}}{{t "nav.profile"}}{{end}}</div>
        <div class="aside__account-phone">{{.MaskedPhone}}</div>
      </div>
    </div>
    <a class="aside__link" href="/orders"><i class="ti ti-package"></i> {{t "sidebar.orders"}} <span class="aside__link-count">{{.OrdersCount}}</span></a>
    <a class="aside__link" href="/favorites"><i class="ti ti-heart"></i> {{t "sidebar.favorites"}} <span class="aside__link-count">{{.FavCount}}</span></a>
  </div>
  {{else}}
  <a class="btn btn--primary aside__login" href="/profile">{{t "sidebar.login"}}</a>
  {{end}}

  <nav class="aside__card" aria-label="{{t "sidebar.categories"}}">
    <div class="aside__title">{{t "sidebar.categories"}}</div>
    {{if eq .Screen "shop"}}
    {{range .Data.Categories}}
    <a class="aside__pill{{if .Active}} aside__pill--active{{end}}"
       href="{{.Href}}"{{if .Active}} aria-current="page"{{end}}
       hx-get="{{.Href}}" hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true"
       hx-include="#shop-q, #shop-filters, #shop-sort">{{.Label}}</a>
    {{end}}
    {{else}}
    <a class="aside__pill" href="/">{{t "sidebar.category.all"}}</a>
    {{end}}
  </nav>

  {{if eq .Screen "shop"}}
  {{$d := .Data}}
  <form id="shop-filters" class="aside__card aside__filters" method="get" action="{{$d.BasePath}}"
        hx-get="{{$d.BasePath}}" hx-trigger="change, submit"
        hx-target="#shop-results" hx-select="#shop-results" hx-swap="outerHTML" hx-push-url="true"
        hx-include="#shop-q, #shop-sort">
    {{if $d.SizeOptions}}
    <fieldset class="aside__fieldset">
      <legend class="aside__title">{{t "filter.size"}}</legend>
      <div class="aside__chips">
        <label class="chip-radio"><input type="radio" name="size" value=""{{if not $d.Size}} checked{{end}}><span>{{t "filter.any"}}</span></label>
        {{range $d.SizeOptions}}
        <label class="chip-radio"><input type="radio" name="size" value="{{.Value}}"{{if .Selected}} checked{{end}}><span>{{.Label}}</span></label>
        {{end}}
      </div>
    </fieldset>
    {{end}}

    {{if $d.ColorOptions}}
    <fieldset class="aside__fieldset">
      <legend class="aside__title">{{t "filter.color"}}</legend>
      <div class="aside__chips">
        <label class="chip-radio"><input type="radio" name="color" value=""{{if not $d.Color}} checked{{end}}><span>{{t "filter.any"}}</span></label>
        {{range $d.ColorOptions}}
        <label class="chip-radio"><input type="radio" name="color" value="{{.Value}}"{{if .Selected}} checked{{end}}><span>{{.Label}}</span></label>
        {{end}}
      </div>
    </fieldset>
    {{end}}

    <fieldset class="aside__fieldset">
      <legend class="aside__title">{{t "filter.availability"}}</legend>
      <label class="aside__checkbox"><input type="checkbox" name="in_stock" value="1"{{if $d.InStock}} checked{{end}}> {{t "filter.in_stock"}}</label>
    </fieldset>

    <fieldset class="aside__fieldset">
      <legend class="aside__title">{{t "filter.price"}}</legend>
      <div class="aside__price">
        <label class="aside__price-field"><span>{{t "filter.price_from"}}</span>
          <input type="number" name="price_min" inputmode="numeric" min="0" step="100" value="{{if $d.PriceMin}}{{$d.PriceMin}}{{end}}" placeholder="0">
        </label>
        <label class="aside__price-field"><span>{{t "filter.price_to"}}</span>
          <input type="number" name="price_max" inputmode="numeric" min="0" step="100" value="{{if $d.PriceMax}}{{$d.PriceMax}}{{end}}" placeholder="∞">
        </label>
      </div>
    </fieldset>

    <div class="aside__filter-actions">
      <button type="submit" class="btn btn--ghost aside__apply">{{t "filter.apply"}}</button>
      {{if $d.HasFilters}}<a class="aside__reset" href="{{$d.BasePath}}">{{t "sidebar.reset"}}</a>{{end}}
    </div>
  </form>
  {{end}}
</aside>
{{end}}
