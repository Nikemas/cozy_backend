{{define "content"}}
<div class="screen-placeholder done-screen">
  <div class="done-screen__check"><i class="ti ti-circle-check" aria-hidden="true"></i></div>
  <h1>{{t "screen.done.title"}}</h1>
  {{if .Data.OrderNumber}}<p class="done-screen__number">{{.Data.OrderNumber}}</p>{{end}}
  <p class="done-screen__total">{{t "done.total"}}: {{money .Data.Total}}</p>
  {{/* No delivery-slot calculation is specified (the design prototype's
       "сегодня 18:00—21:00" was illustrative), so the hint states who
       gets in touch next rather than inventing a time window. */}}
  {{if .Data.Pickup}}
  <p class="muted">{{t "done.pickup_window"}}{{with .Data.PickupPointName}}: {{.}}{{end}}</p>
  {{else}}
  <p class="muted">{{t "done.delivery_window"}}</p>
  {{end}}
  <a class="btn btn--primary" href="/">{{t "common.back_home"}}</a>
</div>
{{end}}
