{{define "content"}}
<article class="static-page">
  <h1>Байланыш</h1>

  {{with .Data.Contacts}}{{if .HasAny}}
  <div class="static-contacts">
    {{if .Phone}}<div class="static-contacts__item"><i class="ti ti-phone" aria-hidden="true"></i><div><div class="static-contacts__label">Телефон</div><a href="tel:{{.PhoneDial}}">{{.Phone}}</a></div></div>{{end}}
    {{if .WhatsApp}}<div class="static-contacts__item"><i class="ti ti-brand-whatsapp" aria-hidden="true"></i><div><div class="static-contacts__label">WhatsApp</div><a href="{{.WhatsAppURL}}" target="_blank" rel="noopener">{{.WhatsApp}}</a></div></div>{{end}}
    {{if .Telegram}}<div class="static-contacts__item"><i class="ti ti-brand-telegram" aria-hidden="true"></i><div><div class="static-contacts__label">Telegram</div><a href="{{.TelegramURL}}" target="_blank" rel="noopener">{{.TelegramHandle}}</a></div></div>{{end}}
    {{if .Email}}<div class="static-contacts__item"><i class="ti ti-mail" aria-hidden="true"></i><div><div class="static-contacts__label">E-mail</div><a href="mailto:{{.Email}}">{{.Email}}</a></div></div>{{end}}
    {{if .Hours}}<div class="static-contacts__item"><i class="ti ti-clock" aria-hidden="true"></i><div><div class="static-contacts__label">Колдоо кызматынын иш убактысы</div>{{.Hours}}</div></div>{{end}}
  </div>
  {{end}}{{end}}

  <h2>Дүкөндөр</h2>
  <p>Бардык дүкөндөрдүн даректери, иш убактысы жана маршруттары — <a href="/branches">Филиалдар</a> барагында.</p>

  {{with .Data.Contacts}}{{if or .LegalName .TaxID .LegalAddress}}
  <h2>Реквизиттер</h2>
  <ul class="static-requisites">
    {{with .LegalName}}<li>{{.}}</li>{{end}}
    {{with .TaxID}}<li>ИНН: {{.}}</li>{{end}}
    {{with .LegalAddress}}<li>Юридикалык дареги: {{.}}</li>{{end}}
  </ul>
  {{end}}{{end}}
</article>
{{end}}
