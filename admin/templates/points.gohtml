{{/* points.gohtml — Task 5 (Точки продаж, Cozy Admin.dc.html lines
     620-642 + pointModal 684-703). Owner-only. .Data is admin.pointsPageData
     (internal/admin/points_page.go). */}}
{{define "content"}}
<div class="admin-screen-narrow">
  <div class="admin-list-toolbar">
    <div class="admin-list-note">Остатки ведутся по каждой точке отдельно (карточка товара, раздел «Остатки»). Деактивированная точка не показывается покупателям, но её история заказов и остатки сохраняются.</div>
    <button type="button" class="admin-btn admin-btn--primary" onclick="openPointModal()">+ Добавить точку</button>
  </div>

  {{/* .Data is admin.pointsPageData, but PageData.Data is an `any` that
       Foundation's own generic render-exec test leaves nil for other
       screens' fixtures — {{with}} skips the whole block (rather than
       erroring on a nil-interface field access) whenever that's the
       case, so this template still executes standalone. */}}
  {{with .Data}}
  {{if .Error}}<div class="admin-form-error">{{.Error}}</div>{{end}}

  <div class="admin-row-list">
    {{if not .Rows}}
      <div class="admin-row-list__empty">Пока нет точек продаж</div>
    {{end}}
    {{range .Rows}}
    <div class="admin-row">
      <div class="admin-row__icon">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10"></path></svg>
      </div>
      <div class="admin-row__info">
        <div class="admin-row__title">{{.Name}}</div>
        <div class="admin-row__subtitle">{{.Address}}</div>
      </div>
      <span class="admin-chip {{.ChipClass}}">{{.ChipLabel}}</span>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--row"
              data-id="{{.ID}}" data-name="{{.Name}}" data-address="{{.Address}}"
              onclick="openPointModal(this)" aria-label="Изменить точку «{{.Name}}»">Изменить</button>
      <form method="post" action="/admin/points/{{.ID}}/toggle"{{if .IsActive}}
            data-confirm="Точка «{{.Name}}» перестанет показываться покупателям, и на неё нельзя будет оформить самовывоз. История заказов и остатки сохранятся."
            data-confirm-title="Деактивировать точку?" data-confirm-label="Деактивировать" data-confirm-danger="1"{{end}}>
        <button type="submit" class="admin-btn admin-btn--secondary admin-btn--row">{{.ToggleLabel}}</button>
      </form>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="admin-row-list"><div class="admin-row-list__empty">Пока нет точек продаж</div></div>
  {{end}}
</div>

{{/* Add/edit-point modal — design canvas's pointModal block (lines
     684-703). One modal for both: openPointModal() with no argument opens
     it empty (POST /admin/points), with an "Изменить" button it prefills
     name/address from the button's data-* and posts to /admin/points/{id}.
     Plain <form method="post">: a full page reload after submit. */}}
<div id="admin-point-modal" class="admin-modal-backdrop" style="display:none">
  <div class="admin-modal admin-modal--md" role="dialog" aria-modal="true" aria-labelledby="admin-point-modal-title">
    <div class="admin-modal__title" id="admin-point-modal-title">Новая точка продаж</div>
    <form method="post" action="/admin/points" id="admin-point-form">
      <div class="admin-field">
        <label for="point-name">Название</label>
        <input id="point-name" name="name" placeholder="Дордой-Центр" required maxlength="200">
      </div>
      <div class="admin-field">
        <label for="point-address">Адрес</label>
        <input id="point-address" name="address" placeholder="ул. Дордой, 1" required maxlength="300">
      </div>
      <div class="admin-modal__actions">
        <button type="button" class="admin-btn admin-btn--secondary" onclick="closePointModal()">Отмена</button>
        <button type="submit" class="admin-btn admin-btn--primary">Сохранить</button>
      </div>
    </form>
  </div>
</div>
<script>
function openPointModal(btn) {
  var form = document.getElementById('admin-point-form');
  var title = document.getElementById('admin-point-modal-title');
  var name = document.getElementById('point-name');
  var address = document.getElementById('point-address');
  if (btn && btn.dataset && btn.dataset.id) {
    form.action = '/admin/points/' + encodeURIComponent(btn.dataset.id);
    title.textContent = 'Редактировать точку';
    name.value = btn.dataset.name || '';
    address.value = btn.dataset.address || '';
  } else {
    form.action = '/admin/points';
    title.textContent = 'Новая точка продаж';
    name.value = '';
    address.value = '';
  }
  document.getElementById('admin-point-modal').style.display = 'flex';
}
function closePointModal() { document.getElementById('admin-point-modal').style.display = 'none'; }
</script>
{{end}}
