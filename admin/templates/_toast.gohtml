{{/* _toast mirrors internal/web's _toast.gohtml pattern: a stable
     #admin-toast-slot present on every page load so a future HTMX
     response can push a toast in via an out-of-band swap
     (hx-swap-oob="innerHTML" on #admin-toast-slot) without needing to
     target it explicitly from every button. */}}
{{define "_toast"}}
<div id="admin-toast-slot">
{{if .Toast}}<div class="admin-toast">{{.Toast}}</div>{{end}}
</div>
{{end}}
