{{/* orders.gohtml — Заказы list (Cozy Admin.dc.html lines 405-497): status
     chips + date-range filter (fix/admin: + search by number/phone, point
     select, custom range), desktop table / mobile cards (same .Rows,
     switched by the @media rule on .admin-orders-table/.admin-orders-cards
     in admin.css), empty state. Data is internal/admin/orders.go's
     OrdersListData. No client-side skeleton loading — the page only
     renders once the server already has the rows (Task 3 brief: "skip —
     no fake delay needed server-side"). */}}
{{define "content"}}
<h1>{{t "admin.nav.orders"}}</h1>

<form method="get" action="/admin/orders" class="admin-filterbar" role="search" id="orders-filter">
  {{if .Data.Status}}<input type="hidden" name="status" value="{{.Data.Status}}">{{end}}
  <div class="admin-field admin-filterbar__field admin-filterbar__field--grow">
    <label for="orders-q">{{t "admin.common.search"}}</label>
    <input type="search" id="orders-q" name="q" value="{{.Data.Query}}" placeholder="{{t "admin.orders.search_placeholder"}}" maxlength="100">
  </div>
  {{if .Data.CanChoosePoint}}
  <div class="admin-field admin-filterbar__field">
    <label for="orders-point">{{t "admin.common.point_of_sale"}}</label>
    <select id="orders-point" name="point" onchange="this.form.submit()">
      {{range .Data.Points}}<option value="{{.ID}}"{{if .Selected}} selected{{end}}>{{.Name}}</option>{{end}}
    </select>
  </div>
  {{end}}
  <div class="admin-field admin-filterbar__field">
    <label for="orders-range">{{t "admin.common.period"}}</label>
    <select id="orders-range" name="range" onchange="ordersRangeChanged(this)">
      {{range .Data.RangeOptions}}
      <option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>
      {{end}}
    </select>
  </div>
  <div class="admin-filterbar__dates" id="orders-dates"{{if ne .Data.Range "custom"}} hidden{{end}}>
    <div class="admin-field admin-filterbar__field">
      <label for="orders-from">{{t "admin.common.from"}}</label>
      <input type="date" id="orders-from" name="from" value="{{.Data.From}}">
    </div>
    <div class="admin-field admin-filterbar__field">
      <label for="orders-to">{{t "admin.common.to"}}</label>
      <input type="date" id="orders-to" name="to" value="{{.Data.To}}">
    </div>
  </div>
  <button type="submit" class="admin-btn admin-btn--secondary">{{t "admin.common.find"}}</button>
  {{if .Data.Filtered}}<a href="{{.Data.ResetURL}}" class="admin-btn admin-btn--secondary">{{t "admin.common.reset"}}</a>{{end}}
</form>
<script>
function ordersRangeChanged(sel) {
  var dates = document.getElementById('orders-dates');
  if (sel.value === 'custom') { dates.hidden = false; document.getElementById('orders-from').focus(); return; }
  dates.hidden = true;
  dates.querySelectorAll('input').forEach(function (i) { i.disabled = true; });
  sel.form.submit();
}
</script>

{{range .Data.Notes}}<div class="admin-form-error" role="status">{{.}}</div>{{end}}
<script src="/admin/static/js/bulk.js" defer></script>

<div class="admin-orders-filters">
  <div class="admin-orders-chips" role="group" aria-label="{{t "admin.orders.status_filter"}}">
    {{range .Data.StatusChips}}
    <a href="{{.URL}}" class="admin-chip-btn {{.Class}}{{if .Active}} active{{end}}"{{if .Active}} aria-current="true"{{end}}>{{.Label}}</a>
    {{end}}
  </div>
</div>

<div class="admin-card">
  {{if .Data.Empty}}
  <div class="admin-empty">
    <div class="admin-empty__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96 12 12.01l8.73-5.05 M12 22.08V12"></path></svg>
    </div>
    <div class="admin-empty__title">{{if .Data.Filtered}}{{t "admin.orders.empty_filtered_title"}}{{else}}{{t "admin.orders.empty_title"}}{{end}}</div>
    <div class="admin-empty__text">{{if .Data.Filtered}}{{t "admin.orders.empty_filtered_text"}}{{else}}{{t "admin.orders.empty_text"}}{{end}}</div>
  </div>
  {{else}}
  {{/* fix/admin-ops: bulk status bar, shown by bulk.js once a row is checked. */}}
  <form method="post" action="{{.Data.BulkURL}}" id="orders-bulk" class="admin-bulkbar" data-bulk hidden>
    <input type="hidden" name="back" value="{{.Data.ReturnURL}}">
    <span class="admin-bulkbar__count">{{t "admin.bulk.selected"}}: <span class="js-bulk-count">0</span></span>
    <label class="admin-visually-hidden" for="orders-bulk-status">{{t "admin.bulk.new_status"}}</label>
    <select id="orders-bulk-status" name="status">
      <option value="">{{t "admin.bulk.new_status"}}…</option>
      {{range .Data.BulkStatuses}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
    </select>
    <button type="button" class="admin-btn admin-btn--dark" data-bulk-action="" data-bulk-requires="status"
      data-bulk-title="{{t "admin.bulk.orders_title"}}" data-bulk-confirm="{{t "admin.bulk.orders_confirm"}}">{{t "admin.bulk.apply"}}</button>
  </form>
  <div class="admin-orders-table">
    <table>
      <thead>
        <tr>
          <th class="admin-orders-table__check"><input type="checkbox" class="js-bulk-all" data-bulk-for="orders-bulk" aria-label="{{t "admin.bulk.select_all_orders"}}"></th>
          <th>{{t "admin.orders.col_number"}}</th>
          <th>{{t "admin.orders.col_date"}}</th>
          <th>{{t "admin.orders.col_customer"}}</th>
          <th>{{t "admin.orders.col_items"}}</th>
          <th style="text-align:right">{{t "admin.orders.col_total"}}</th>
          <th>{{t "admin.orders.col_payment"}}</th>
          <th>{{t "admin.common.status"}}</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.Rows}}
        <tr onclick="location.href='{{.URL}}'">
          <td class="admin-orders-table__check" onclick="event.stopPropagation()"><input type="checkbox" class="js-bulk-item" form="orders-bulk" name="id" value="{{.ID}}" aria-label="{{tf "admin.bulk.select_order" .Number}}"></td>
          <td class="admin-orders-table__num"><a href="{{.URL}}">{{.Number}}</a></td>
          <td class="admin-orders-table__muted">{{.DateLabel}}</td>
          <td class="admin-orders-table__phone">{{.Phone}}</td>
          <td><span class="admin-orders-table__items">{{if .ThumbURL}}<img class="admin-orders-thumb" src="{{.ThumbURL}}" alt="" width="36" height="36" loading="lazy">{{else}}<span class="admin-orders-thumb"></span>{{end}}{{.ItemsCount}}</span></td>
          <td class="admin-orders-table__sum">{{.TotalLabel}}</td>
          <td class="admin-orders-table__muted">{{.PaymentLabel}}</td>
          <td><span class="admin-chip {{.StatusClass}}">{{.StatusLabel}}</span></td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>

  <div class="admin-orders-cards">
    {{range .Data.Rows}}
    <div class="admin-order-card" onclick="location.href='{{.URL}}'">
      <div class="admin-order-card__top">
        <a href="{{.URL}}" class="admin-order-card__num">{{.Number}}</a>
        <span class="admin-chip {{.StatusClass}}">{{.StatusLabel}}</span>
      </div>
      <div class="admin-order-card__phone">{{if .ThumbURL}}<img class="admin-orders-thumb" src="{{.ThumbURL}}" alt="" width="36" height="36" loading="lazy">{{end}}{{.Phone}}</div>
      <div class="admin-order-card__meta">
        <span>{{.DateLabel}}</span>
        <span>{{.ItemsLabel}}</span>
        <span>{{.PaymentLabel}}</span>
        <span class="admin-order-card__sum">{{.TotalLabel}}</span>
      </div>
    </div>
    {{end}}
  </div>

  <div class="admin-orders-footer">
    <div class="admin-orders-count">{{.Data.CountLabel}}</div>
    {{if or .Data.HasPrev .Data.HasNext}}
    <div class="admin-orders-pager">
      {{if .Data.HasPrev}}<a href="{{.Data.PrevURL}}" class="admin-btn admin-btn--secondary">{{t "admin.common.prev"}}</a>{{end}}
      {{if .Data.HasNext}}<a href="{{.Data.NextURL}}" class="admin-btn admin-btn--secondary">{{t "admin.common.next"}}</a>{{end}}
    </div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
