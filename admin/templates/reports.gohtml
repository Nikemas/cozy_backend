{{/* reports.gohtml — Отчёты (Task 4, Wave 4), replacing Foundation's stub.
     Cozy Admin.dc.html lines 558-618: period select + Excel export, 4 stat
     cards, a per-day CSS bar chart, "Топ товаров" and "По брендам" ranked
     lists, plus (fix/admin) a custom date range and "По категориям". .Data is a *internal/admin/reports.go's ReportsData, built by
     handlers.buildReportsData — see that file for how each field here is
     computed from internal/reports.AggregateSales' output. */}}
{{define "content"}}
<div class="admin-reports">
  <form method="get" class="admin-reports__toolbar">
    <label for="report-period" class="admin-visually-hidden">{{t "admin.common.period"}}</label>
    <select id="report-period" name="period" class="admin-reports__period" onchange="reportsPeriodChanged(this)">
      {{range .Data.Periods}}
      <option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
      {{end}}
    </select>
    <span class="admin-reports__custom" id="report-custom"{{if not .Data.Custom}} hidden{{end}}>
      <label for="report-from">{{t "admin.reports.from"}}</label>
      <input type="date" id="report-from" name="from" value="{{.Data.From}}">
      <label for="report-to">{{t "admin.reports.to"}}</label>
      <input type="date" id="report-to" name="to" value="{{.Data.To}}">
      <button type="submit" class="admin-btn admin-btn--secondary">{{t "admin.reports.show"}}</button>
    </span>
    <div class="admin-reports__spacer"></div>
    <a class="admin-btn admin-btn--secondary" href="{{.Data.ExportURL}}">{{t "admin.reports.export"}}</a>
  </form>
  {{if .Data.Err}}<div class="admin-form-error" role="alert">{{.Data.Err}}</div>{{end}}
  <div class="admin-reports__note">{{t "admin.reports.note"}}</div>
  <script>
  function reportsPeriodChanged(sel) {
    var custom = document.getElementById('report-custom');
    if (sel.value === 'custom') { custom.hidden = false; document.getElementById('report-from').focus(); return; }
    custom.hidden = true;
    custom.querySelectorAll('input').forEach(function (i) { i.disabled = true; });
    sel.form.submit();
  }
  </script>

  <div class="admin-stat-grid">
    {{range .Data.Stats}}
    <div class="admin-stat-card">
      <div class="admin-stat-card__label">{{.Label}}</div>
      <div class="admin-stat-card__value">{{.Value}}</div>
      <div class="admin-stat-card__note">{{.Note}}</div>
    </div>
    {{end}}
  </div>

  <div class="admin-reports__card">
    <div class="admin-reports__chart-title">{{t "admin.reports.sales_by_day"}}</div>
    <div class="admin-reports__chart-note">{{.Data.ChartNote}}</div>
    <div class="admin-bars">
      {{range .Data.Bars}}
      <div class="admin-bars__col">
        <div class="admin-bars__bar" style="height: {{.HeightPct}}%" title="{{.Revenue}}"></div>
        <div class="admin-bars__label">{{.Day}}</div>
      </div>
      {{end}}
    </div>
  </div>

  <div class="admin-reports__lists">
    <div class="admin-reports__card admin-ranked-list">
      <div class="admin-ranked-list__title">{{t "admin.reports.top_products"}}</div>
      {{if .Data.TopProducts}}
        {{range .Data.TopProducts}}
        <div class="admin-ranked-list__row">
          <div class="admin-ranked-list__rank">{{.Rank}}</div>
          <div class="admin-ranked-list__name">{{.Name}}</div>
          <div class="admin-ranked-list__value">{{.Qty}}</div>
        </div>
        {{end}}
      {{else}}
      <div class="admin-ranked-list__empty">{{t "admin.reports.no_sales"}}</div>
      {{end}}
    </div>

    <div class="admin-reports__card admin-ranked-list">
      <div class="admin-ranked-list__title">{{t "admin.reports.by_brand"}}</div>
      {{if .Data.TopBrands}}
        {{range .Data.TopBrands}}
        <div class="admin-ranked-list__row">
          <div class="admin-ranked-list__name">{{.Name}}</div>
          <div class="admin-brand-bar"><div class="admin-brand-bar__fill" style="width: {{.WidthPct}}%"></div></div>
          <div class="admin-ranked-list__value admin-ranked-list__value--wide">{{.Sum}}</div>
        </div>
        {{end}}
      {{else}}
      <div class="admin-ranked-list__empty">{{t "admin.reports.no_sales"}}</div>
      {{end}}
    </div>
  </div>

  <div class="admin-reports__card admin-ranked-list">
    <div class="admin-ranked-list__title">{{t "admin.reports.by_category"}}</div>
    {{if .Data.Categories}}
    <table class="admin-table admin-category-report">
      <thead>
        <tr><th scope="col">{{t "admin.common.category"}}</th><th scope="col">{{t "admin.reports.col_share"}}</th><th scope="col">{{t "admin.reports.col_orders"}}</th><th scope="col">{{t "admin.reports.col_sold"}}</th><th scope="col" class="admin-table__num-col">{{t "admin.reports.revenue"}}</th></tr>
      </thead>
      <tbody>
        {{range .Data.Categories}}
        <tr>
          <td>{{.Name}}</td>
          <td><div class="admin-brand-bar" aria-hidden="true"><div class="admin-brand-bar__fill" style="width: {{.WidthPct}}%"></div></div></td>
          <td class="admin-table__muted">{{.Orders}}</td>
          <td class="admin-table__muted">{{.Qty}}</td>
          <td class="admin-table__num">{{.Sum}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}
    <div class="admin-ranked-list__empty">{{t "admin.reports.no_sales"}}</div>
    {{end}}
  </div>
</div>
{{end}}
