{{/* staff.gohtml — Task 5 (Сотрудники, Cozy Admin.dc.html lines 644-664 +
     staffModal 706-741). Owner-only. .Data is admin.staffPageData
     (internal/admin/staff_page.go). */}}
{{define "content"}}
{{/* $pdata: .Data is admin.staffPageData, but PageData.Data is an `any`
     that Foundation's own generic render-exec test leaves nil for other
     screens' fixtures — captured once so both the list below and the
     modal's point select further down can each guard against that nil
     case ({{if $pdata}}/{{with $pdata}}) without erroring on a
     nil-interface field access. */}}
{{$pdata := .Data}}
<div class="admin-screen-narrow">
  <div class="admin-list-toolbar admin-list-toolbar--end">
    <button type="button" class="admin-btn admin-btn--primary" onclick="openStaffModal()">+ {{t "admin.staff.add"}}</button>
  </div>

  {{with $pdata}}
  {{if .Error}}<div class="admin-form-error" role="alert">{{.Error}}</div>{{end}}
  {{if .Notice}}<div class="admin-form-error" role="status" style="color:var(--admin-text);background:var(--admin-primary-tint)">{{.Notice}}</div>{{end}}

  <div class="admin-row-list">
    {{if not .Rows}}
      <div class="admin-row-list__empty">{{t "admin.staff.empty"}}</div>
    {{end}}
    {{range .Rows}}
    <div class="admin-row">
      <div class="admin-row__avatar">{{.Initials}}</div>
      <div class="admin-row__info">
        <div class="admin-row__title">{{.Name}}</div>
        <div class="admin-row__subtitle">{{.Phone}}</div>
      </div>
      <span class="admin-chip {{.RoleClass}}">{{.RoleLabel}}</span>
      <div class="admin-row__scope">{{.Scope}}</div>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--row"
              data-staff-id="{{.ID}}" data-staff-name="{{.Name}}"
              onclick="openStaffPasswordModal(this)">{{t "admin.staff.change_password"}}</button>
      <form method="post" action="/admin/staff/{{.ID}}/toggle"
            {{if .IsActive}}data-confirm="{{tf "admin.staff.deactivate_confirm" .Name}}" onsubmit="return confirmStaffAction(this)"{{end}}>
        <button type="submit" class="admin-btn admin-btn--secondary admin-btn--row">{{.ToggleLabel}}</button>
      </form>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="admin-row-list"><div class="admin-row-list__empty">{{t "admin.staff.empty"}}</div></div>
  {{end}}
</div>

{{/* Add-staff modal — design canvas's staffModal block (lines 706-741).
     Two deviations from the canvas, both because the canvas has no real
     backend behind it: (1) the role <select>'s values are the actual
     staff.Role strings ("manager"/"point_staff") instead of the canvas's
     display-text values, so the server can parse them directly; (2) a
     "Точка" select is added (hidden unless role=point_staff, via
     toggleStaffPointField() below) because
     staff.Service.CreateStaff requires point_id for point_staff and
     rejects it for owner/manager — the canvas's staffModal has no such
     field since it only ever models owner/manager staff. */}}
<div id="admin-staff-modal" class="admin-modal-backdrop" style="display:none">
  <div class="admin-modal admin-modal--lg">
    <div class="admin-modal__title">{{t "admin.staff.new_title"}}</div>
    <form method="post" action="/admin/staff">
      <div class="admin-field">
        <label for="staff-name">{{t "admin.staff.name"}}</label>
        <input id="staff-name" name="name" placeholder="Айгерим Б." required>
      </div>
      <div class="admin-field-row">
        <div class="admin-field">
          <label for="staff-phone">{{t "admin.staff.phone"}}</label>
          <input id="staff-phone" name="phone" placeholder="+996 555 123 456" required>
        </div>
        <div class="admin-field">
          <label for="staff-role">{{t "admin.staff.role"}}</label>
          <select id="staff-role" name="role" onchange="toggleStaffPointField()">
            <option value="manager">{{t "admin.role.manager"}}</option>
            <option value="point_staff">{{t "admin.role.point_staff"}}</option>
          </select>
        </div>
      </div>
      <div class="admin-field" id="staff-point-field" style="display:none">
        <label for="staff-point">{{t "admin.common.point_of_sale"}}</label>
        <select id="staff-point" name="point_id">
          {{if $pdata}}{{range $pdata.Points}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}
        </select>
      </div>
      <div class="admin-field">
        <label for="staff-password">{{t "admin.login.password"}}</label>
        <div class="admin-password-row">
          <input id="staff-password" name="password" placeholder="{{if $pdata}}{{tf "admin.staff.password_min" $pdata.MinPasswordLength}}{{else}}{{tf "admin.staff.password_min" 8}}{{end}}" minlength="{{if $pdata}}{{$pdata.MinPasswordLength}}{{else}}8{{end}}" maxlength="72" autocomplete="new-password" required>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--row" onclick="generateStaffPassword('staff-password')">{{t "admin.common.generate"}}</button>
        </div>
      </div>
      <div class="admin-modal__actions">
        <button type="button" class="admin-btn admin-btn--secondary" onclick="closeStaffModal()">{{t "admin.common.cancel"}}</button>
        <button type="submit" class="admin-btn admin-btn--primary">{{t "admin.common.save"}}</button>
      </div>
    </form>
  </div>
</div>
{{/* Owner resets a staff member's password — one modal shared by every
     row; openStaffPasswordModal() points the form at that row's id. */}}
<div id="admin-staff-password-modal" class="admin-modal-backdrop" style="display:none" role="dialog" aria-modal="true" aria-labelledby="staff-password-modal-title">
  <div class="admin-modal">
    <div class="admin-modal__title" id="staff-password-modal-title">{{t "admin.staff.new_password"}}: <span id="staff-password-modal-name"></span></div>
    <form method="post" id="staff-password-form" action="">
      <div class="admin-field">
        <label for="staff-new-password">{{t "admin.staff.new_password"}}</label>
        <div class="admin-password-row">
          <input id="staff-new-password" name="password" minlength="{{if $pdata}}{{$pdata.MinPasswordLength}}{{else}}8{{end}}" maxlength="72" autocomplete="new-password" required>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--row" onclick="generateStaffPassword('staff-new-password', 'staff-new-password-confirm')">{{t "admin.common.generate"}}</button>
        </div>
      </div>
      <div class="admin-field">
        <label for="staff-new-password-confirm">{{t "admin.staff.repeat_password"}}</label>
        <input id="staff-new-password-confirm" name="password_confirm" minlength="{{if $pdata}}{{$pdata.MinPasswordLength}}{{else}}8{{end}}" maxlength="72" autocomplete="new-password" required>
      </div>
      <div class="admin-list-note">{{t "admin.staff.password_note"}}</div>
      <div class="admin-modal__actions">
        <button type="button" class="admin-btn admin-btn--secondary" onclick="closeStaffPasswordModal()">{{t "admin.common.cancel"}}</button>
        <button type="submit" class="admin-btn admin-btn--primary">{{t "admin.staff.save_password"}}</button>
      </div>
    </form>
  </div>
</div>
<script>
function confirmStaffAction(form) { return window.confirm(form.dataset.confirm); }
function openStaffPasswordModal(btn) {
  var form = document.getElementById('staff-password-form');
  form.action = '/admin/staff/' + encodeURIComponent(btn.dataset.staffId) + '/password';
  form.reset();
  document.getElementById('staff-password-modal-name').textContent = btn.dataset.staffName;
  document.getElementById('admin-staff-password-modal').style.display = 'flex';
  document.getElementById('staff-new-password').focus();
}
function closeStaffPasswordModal() { document.getElementById('admin-staff-password-modal').style.display = 'none'; }
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') { closeStaffPasswordModal(); closeStaffModal(); }
});
function openStaffModal() {
  document.getElementById('admin-staff-modal').style.display = 'flex';
  toggleStaffPointField();
}
function closeStaffModal() { document.getElementById('admin-staff-modal').style.display = 'none'; }
function toggleStaffPointField() {
  var role = document.getElementById('staff-role').value;
  document.getElementById('staff-point-field').style.display = role === 'point_staff' ? 'flex' : 'none';
}
// Generates a 12-character password with the browser's CSPRNG (not
// Math.random) and shows it in the field(s) so the owner can pass it on.
function generateStaffPassword() {
  var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
  var buf = new Uint32Array(12);
  window.crypto.getRandomValues(buf);
  var pass = '';
  for (var i = 0; i < buf.length; i++) { pass += chars.charAt(buf[i] % chars.length); }
  for (var j = 0; j < arguments.length; j++) {
    var el = document.getElementById(arguments[j]);
    el.value = pass;
    el.type = 'text';
  }
}
</script>
{{end}}
