{{/* no_access.gohtml — landing page for a staff member whose role has no
     admin screen at all (an unknown role; point_staff now has Заказы and
     Остатки of its own point). Reuses the login screen's chrome-free
     centered-card look rather than the full sidebar shell, since there's
     no nav to show them. */}}
{{define "content"}}
<div class="admin-login">
  <div class="admin-login__card">
    <div class="admin-login__logo">
      <img src="/admin/static/img/cozy-logo.png" alt="Cozy" width="84" height="84">
    </div>
    <div class="admin-login__title">{{t "admin.no_access.title"}}</div>
    <div class="admin-login__hint">{{t "admin.no_access.text"}}</div>
    <form method="post" action="/admin/logout" style="margin-top: 18px">
      <button type="submit" class="admin-btn admin-btn--secondary admin-login__submit">{{t "admin.common.logout"}}</button>
    </form>
  </div>
</div>
{{end}}
