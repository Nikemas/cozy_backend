{{/* product_form.gohtml — Wave 4 Task 2 (Товары: форма создания/
     редактирования, Cozy Admin.dc.html lines 254-374). PageData.Data is a
     *admin.ProductFormData built by productNewPage/productEditPage/
     rerenderFormOnError (products.go). */}}
{{define "content"}}
{{with .Data}}
<form method="post" action="{{if .IsEdit}}/admin/products/{{.ProductID}}{{else}}/admin/products{{end}}" class="admin-product-form" id="product-form">
  <input type="hidden" name="category_id" id="pf-category-id" value="{{.CategoryID}}">

  {{if .Err}}
  <div class="admin-form-error">{{.Err}}</div>
  {{end}}

  <div class="admin-form-grid">
    <div class="admin-card admin-card--pad">
      <div class="admin-langtabs">
        <button type="button" class="admin-langtabs__btn active" data-lang="ru" onclick="pfSetLang('ru')">{{t "admin.lang.ru_title"}}</button>
        <button type="button" class="admin-langtabs__btn" data-lang="ky" onclick="pfSetLang('ky')">{{t "admin.lang.ky_title"}}</button>
      </div>

      <div class="admin-field admin-lang-field" data-lang="ru">
        <label>{{t "admin.common.name_ru"}}</label>
        <input type="text" name="name_ru" value="{{.NameRu}}" placeholder="Nike Air Max 90" required>
      </div>
      <div class="admin-field admin-lang-field" data-lang="ky" hidden>
        <label>{{t "admin.common.name_ky"}}</label>
        <input type="text" name="name_ky" value="{{.NameKy}}" placeholder="Nike Air Max 90" required>
      </div>

      <div class="admin-form-row3">
        <div class="admin-field">
          <div class="admin-field__labelrow">
            <label>{{t "admin.common.category"}}</label>
            <button type="button" class="admin-linkbtn" onclick="openCategoryModal()">+ {{t "admin.product.new_short"}}</button>
          </div>
          <select id="pf-category" onchange="pfOnCategoryChange()">
            {{range .Categories}}
            <option value="{{.ID}}" data-slug="{{.Slug}}"{{if eq .ID $.Data.TopCategoryID}} selected{{end}}>{{.Name}}</option>
            {{end}}
          </select>
        </div>
        <div class="admin-field">
          <div class="admin-field__labelrow">
            <label>{{t "admin.products.subcategory"}}</label>
            <button type="button" class="admin-linkbtn" onclick="openSubcategoryModal()">+ {{t "admin.product.new_short"}}</button>
          </div>
          <select id="pf-subcategory" onchange="pfOnSubcategoryChange()">
            <option value="">{{t "admin.product.no_subcategory"}}</option>
          </select>
        </div>
        <div class="admin-field">
          <div class="admin-field__labelrow">
            <label>{{t "admin.product.brand"}}</label>
            <button type="button" class="admin-linkbtn" onclick="openBrandModal()">+ {{t "admin.product.new_short"}}</button>
          </div>
          <input type="text" name="brand" id="pf-brand" list="pf-brand-list" value="{{.Brand}}" placeholder="Nike">
          <datalist id="pf-brand-list">
            {{range .Brands}}
            <option value="{{.}}">
            {{end}}
          </datalist>
        </div>
      </div>

      <div class="admin-field" style="max-width:260px">
        <label>{{t "admin.product.base_price"}}</label>
        <input type="text" inputmode="decimal" name="base_price" value="{{.BasePrice}}" placeholder="4500">
      </div>

      <div class="admin-field admin-lang-field" data-lang="ru">
        <label>{{t "admin.product.description_ru"}}</label>
        <textarea name="description_ru" placeholder="{{t "admin.product.description_placeholder"}}">{{.DescriptionRu}}</textarea>
      </div>
      <div class="admin-field admin-lang-field" data-lang="ky" hidden>
        <label>{{t "admin.product.description_ky"}}</label>
        <textarea name="description_ky" placeholder="{{t "admin.product.description_placeholder"}}">{{.DescriptionKy}}</textarea>
      </div>
    </div>

    <div class="admin-card admin-card--pad">
      <div class="admin-card__title">{{t "admin.product.photos"}}</div>
      <div class="admin-card__hint">{{t "admin.product.photos_hint"}}</div>
      <div id="pf-photo-slots" class="admin-photo-grid"></div>
      <button type="button" class="admin-photo-add" onclick="pfPickPhoto()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 5v14M5 12h14"></path></svg>
        <span>{{t "admin.product.add_photo"}}</span>
      </button>
      <input type="file" id="pf-file-input" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="pfFileChosen(event)">
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card__pad-sm">
      <div class="admin-card__title">{{t "admin.product.variants"}}</div>
      <div class="admin-card__hint">{{t "admin.product.variants_hint"}}</div>
      {{if not .StockPoints}}<div class="admin-card__hint">{{t "admin.product.no_points_hint"}}</div>{{end}}
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table admin-variants-table">
        <thead>
          <tr>
            <th scope="col">{{t "admin.common.size"}}</th>
            <th scope="col">{{t "admin.common.color"}}</th>
            <th scope="col">{{t "admin.product.color_photos"}}</th>
            {{range .StockPoints}}
            <th scope="col" class="admin-variants-table__point">{{.Name}}{{if .Inactive}} <span class="admin-variants-table__inactive">{{t "admin.common.inactive_suffix"}}</span>{{end}}</th>
            {{end}}
            <th scope="col">{{t "admin.product.total"}}</th>
            <th scope="col"><span class="admin-visually-hidden">{{t "admin.common.delete"}}</span></th>
          </tr>
        </thead>
        <tbody id="pf-variant-rows">
          {{range .Variants}}
          <tr class="admin-variant-row" data-key="{{.Key}}">
            <td><input type="hidden" name="variant_key" value="{{.Key}}"><input type="hidden" name="variant_id" value="{{.ID}}"><input type="text" name="variant_size" value="{{.Size}}" class="admin-variant-input" placeholder="42" aria-label="{{t "admin.common.size"}}"></td>
            <td><input type="text" name="variant_color" value="{{.Color}}" class="admin-variant-input" placeholder="{{t "admin.product.color_placeholder"}}" aria-label="{{t "admin.common.color"}}"></td>
            <td><button type="button" class="admin-variant-photo-btn" onclick="pfOpenColorPhotos(this)" aria-label="{{t "admin.product.this_color_photos"}}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"></path><circle cx="12" cy="13" r="3.2"></circle></svg>
              <span class="admin-variant-photo-count">0</span>
            </button></td>
            {{range .Cells}}
            <td><input type="number" min="0" max="100000" step="1" inputmode="numeric" name="{{.Name}}" value="{{.Value}}" class="admin-variant-input admin-variant-input--qty{{if .Conflict}} is-conflict{{end}}{{if .Invalid}} is-invalid{{end}}" aria-label="{{t "admin.common.stock"}}: {{.PointName}}"{{if or .Conflict .Invalid}} aria-invalid="true"{{end}}{{if .Conflict}} title="{{t "admin.product.conflict_cell"}}"{{end}} oninput="pfUpdateBadge(this)">{{if .HasOrig}}<input type="hidden" name="{{.OrigName}}" value="{{.Orig}}">{{end}}</td>
            {{end}}
            <td><span class="admin-chip admin-variant-badge" style="color:{{.BadgeFG}};background:{{.BadgeBG}}">{{.BadgeLbl}}</span></td>
            <td><button type="button" class="admin-variant-remove" onclick="pfRemoveVariantRow(this)" aria-label="{{t "admin.product.remove_variant"}}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button></td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    <div class="admin-card__pad-sm">
      <button type="button" class="admin-btn admin-btn--secondary" onclick="pfAddVariant()">+ {{t "admin.product.add_variant"}}</button>
    </div>
  </div>

  <div class="admin-form-sticky">
    <a href="/admin/products" class="admin-btn admin-btn--secondary">{{t "admin.common.cancel"}}</a>
    <button type="submit" class="admin-btn admin-btn--primary">{{t "admin.common.save"}}</button>
  </div>
</form>

<div id="pf-image-inputs"></div>
<script id="pf-initial-images" type="application/json">{{.ImagesJSON}}</script>

{{/* Per-color photo picker: opened from a variant row's "Фото цвета"
     button (pfOpenColorPhotos), scoped to that row's current color text —
     two size rows with the same color share and edit the same photo set,
     since staff only shoots one set of photos per color, not per size. */}}
<div id="pf-colorphoto-modal" class="admin-modal-backdrop" style="display:none">
  <div class="admin-modal admin-modal--lg" role="dialog" aria-modal="true" aria-labelledby="pf-colorphoto-title">
    <div class="admin-modal__title" id="pf-colorphoto-title">{{t "admin.product.color_photos"}}</div>
    <div class="admin-modal__text">{{t "admin.product.color_photos_hint"}}</div>
    <div id="pf-colorphoto-grid" class="admin-photo-grid" style="margin-top:14px"></div>
    <button type="button" class="admin-photo-add" onclick="pfPickColorPhoto()">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 5v14M5 12h14"></path></svg>
      <span>{{t "admin.product.add_photo"}}</span>
    </button>
    <input type="file" id="pf-colorphoto-file-input" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="pfColorFileChosen(event)">
    <div class="admin-modal__actions">
      <button type="button" class="admin-btn admin-btn--primary" onclick="closeColorPhotoModal()">{{t "admin.common.done"}}</button>
    </div>
  </div>
</div>

{{/* Category/subcategory/brand "+ Новая" modals — same admin-modal
     component staff/points already use (admin.css's generic confirm
     modal, reused with a form body instead of confirm text), styled after
     the design canvas's subModal block (Cozy Admin.dc.html ~747-770).
     Replaces the earlier window.prompt()-chain UI with real fields. */}}
<div id="pf-category-modal" class="admin-modal-backdrop" style="display:none">
  <div class="admin-modal admin-modal--md" role="dialog" aria-modal="true" aria-labelledby="pf-category-modal-title">
    <div class="admin-modal__title" id="pf-category-modal-title">{{t "admin.categories.new_title"}}</div>
    <div class="admin-field" style="margin-top:18px">
      <label for="pf-newcat-name">{{t "admin.product.category_name"}}</label>
      <input type="text" id="pf-newcat-name" placeholder="{{t "admin.product.category_placeholder"}}" onkeydown="if(event.key==='Enter')pfSaveCategory()">
    </div>
    <div class="admin-form-error" id="pf-newcat-error" hidden></div>
    <div class="admin-modal__actions">
      <button type="button" class="admin-btn admin-btn--secondary" onclick="closeCategoryModal()">{{t "admin.common.cancel"}}</button>
      <button type="button" class="admin-btn admin-btn--primary" onclick="pfSaveCategory()">{{t "admin.common.add"}}</button>
    </div>
  </div>
</div>

<div id="pf-subcategory-modal" class="admin-modal-backdrop" style="display:none">
  <div class="admin-modal admin-modal--md" role="dialog" aria-modal="true" aria-labelledby="pf-subcategory-modal-title">
    <div class="admin-modal__title" id="pf-subcategory-modal-title">{{t "admin.product.new_subcategory"}}</div>
    <div class="admin-modal__text">{{t "admin.product.subcategory_hint"}}</div>
    <div class="admin-field" style="margin-top:14px">
      <label for="pf-newsub-parent">{{t "admin.common.category"}}</label>
      <select id="pf-newsub-parent"></select>
    </div>
    <div class="admin-field">
      <label for="pf-newsub-name">{{t "admin.product.subcategory_name"}}</label>
      <input type="text" id="pf-newsub-name" placeholder="{{t "admin.product.subcategory_placeholder"}}" onkeydown="if(event.key==='Enter')pfSaveSubcategory()">
    </div>
    <div class="admin-form-error" id="pf-newsub-error" hidden></div>
    <div class="admin-modal__actions">
      <button type="button" class="admin-btn admin-btn--secondary" onclick="closeSubcategoryModal()">{{t "admin.common.cancel"}}</button>
      <button type="button" class="admin-btn admin-btn--primary" onclick="pfSaveSubcategory()">{{t "admin.common.add"}}</button>
    </div>
  </div>
</div>

<div id="pf-brand-modal" class="admin-modal-backdrop" style="display:none">
  <div class="admin-modal admin-modal--md" role="dialog" aria-modal="true" aria-labelledby="pf-brand-modal-title">
    <div class="admin-modal__title" id="pf-brand-modal-title">{{t "admin.product.new_brand"}}</div>
    <div class="admin-field" style="margin-top:18px">
      <label for="pf-newbrand-name">{{t "admin.product.brand_name"}}</label>
      <input type="text" id="pf-newbrand-name" placeholder="New Balance" onkeydown="if(event.key==='Enter')pfSaveBrand()">
    </div>
    <div class="admin-modal__actions">
      <button type="button" class="admin-btn admin-btn--secondary" onclick="closeBrandModal()">{{t "admin.common.cancel"}}</button>
      <button type="button" class="admin-btn admin-btn--primary" onclick="pfSaveBrand()">{{t "admin.common.add"}}</button>
    </div>
  </div>
</div>

<script id="pf-category-tree" type="application/json">{{.CategoriesJSON}}</script>
<script id="pf-stock-points" type="application/json">{{.StockPointsJSON}}</script>

<script>
(function () {
  // Translated strings for the dynamic parts of the form (admin locale).
  var L = {
    enterName: {{t "admin.product.enter_name"}},
    catFailed: {{t "admin.product.category_create_failed"}},
    subFailed: {{t "admin.product.subcategory_create_failed"}},
    noSub: {{t "admin.product.no_subcategory"}},
    outOfStock: {{t "admin.stock.out_of_stock"}},
    pcs: {{t "admin.stock.pcs"}},
    size: {{t "admin.common.size"}},
    color: {{t "admin.common.color"}},
    colorPlaceholder: {{t "admin.product.color_placeholder"}},
    thisColorPhotos: {{t "admin.product.this_color_photos"}},
    stock: {{t "admin.common.stock"}},
    removeVariant: {{t "admin.product.remove_variant"}},
    mainPhoto: {{t "admin.product.main_photo"}},
    maxPhotos: {{t "admin.product.max_photos"}},
    fileTooBig: {{t "admin.product.file_too_big"}},
    uploadOffline: {{t "admin.product.upload_offline"}},
    uploadFailed: {{t "admin.product.upload_failed"}},
    colorFirst: {{t "admin.product.color_first"}},
    colorPhotosOf: {{t "admin.product.color_photos_of"}}
  };
  var initialTop = {{.TopCategoryID}};
  var initialSub = {{.SubCategoryID}};
  var initialCategoryID = {{.CategoryID}};

  // --- language tabs (name/description ru vs ky, both always submitted) ---
  window.pfSetLang = function (lang) {
    document.querySelectorAll('.admin-langtabs__btn').forEach(function (b) {
      b.classList.toggle('active', b.dataset.lang === lang);
    });
    document.querySelectorAll('.admin-lang-field').forEach(function (f) {
      f.hidden = f.dataset.lang !== lang;
    });
  };

  // --- category / subcategory selects ---
  var tree = [];
  try { tree = JSON.parse(document.getElementById('pf-category-tree').textContent || '[]'); } catch (e) { tree = []; }

  function subcategoriesFor(topID) {
    for (var i = 0; i < tree.length; i++) {
      if (tree[i].ID === topID) return tree[i].Children || [];
    }
    return [];
  }

  function populateSubcategories(topID, selectSubID) {
    var sel = document.getElementById('pf-subcategory');
    sel.innerHTML = '';
    var none = document.createElement('option');
    none.value = ''; none.textContent = L.noSub;
    sel.appendChild(none);
    subcategoriesFor(topID).forEach(function (c) {
      var opt = document.createElement('option');
      opt.value = c.ID; opt.textContent = c.Name;
      if (c.ID === selectSubID) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  window.pfOnCategoryChange = function () {
    var topID = document.getElementById('pf-category').value;
    populateSubcategories(topID, '');
    document.getElementById('pf-category-id').value = topID;
  };
  window.pfOnSubcategoryChange = function () {
    var subSel = document.getElementById('pf-subcategory');
    var topID = document.getElementById('pf-category').value;
    document.getElementById('pf-category-id').value = subSel.value || topID;
  };

  populateSubcategories(initialTop || (tree[0] && tree[0].ID) || '', initialSub || '');
  if (!initialCategoryID) { document.getElementById('pf-category-id').value = document.getElementById('pf-category').value; }

  // --- Cyrillic (incl. Kyrgyz ң/ө/ү) -> Latin slug, so a category typed
  // in Russian/Kyrgyz still gets a real URL-safe slug instead of empty
  // dashes (categories.slug is a required, unique column — see
  // catalog.CategoryInput.validate). ---
  var CYR_TO_LAT = {
    а: 'a', б: 'b', в: 'v', г: 'g', д: 'd', е: 'e', ё: 'e', ж: 'zh', з: 'z', и: 'i', й: 'i',
    к: 'k', л: 'l', м: 'm', н: 'n', о: 'o', п: 'p', р: 'r', с: 's', т: 't', у: 'u', ф: 'f',
    х: 'h', ц: 'c', ч: 'ch', ш: 'sh', щ: 'sch', ъ: '', ы: 'y', ь: '', э: 'e', ю: 'yu', я: 'ya',
    ң: 'ng', ө: 'o', ү: 'u',
  };
  function slugify(s) {
    var out = '';
    for (var i = 0; i < s.length; i++) {
      var ch = s[i].toLowerCase();
      out += CYR_TO_LAT.hasOwnProperty(ch) ? CYR_TO_LAT[ch] : ch;
    }
    return out.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  // --- "+ Новая категория" modal ---
  window.openCategoryModal = function () {
    document.getElementById('pf-newcat-name').value = '';
    document.getElementById('pf-newcat-error').hidden = true;
    document.getElementById('pf-category-modal').style.display = 'flex';
    document.getElementById('pf-newcat-name').focus();
  };
  window.closeCategoryModal = function () { document.getElementById('pf-category-modal').style.display = 'none'; };

  window.pfSaveCategory = function () {
    var nameRu = document.getElementById('pf-newcat-name').value.trim();
    var errEl = document.getElementById('pf-newcat-error');
    if (!nameRu) { errEl.textContent = L.enterName; errEl.hidden = false; return; }

    fetch('/admin/api/categories', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ parent_id: null, name_ru: nameRu, name_ky: nameRu, slug: slugify(nameRu), sort_order: 0 })
    }).then(function (r) {
      if (!r.ok) throw new Error('save failed');
      return r.json();
    }).then(function (cat) {
      tree.push({ ID: cat.id, Name: cat.name_ru, Slug: cat.slug, Children: [] });
      var topSel = document.getElementById('pf-category');
      var opt = document.createElement('option');
      opt.value = cat.id; opt.textContent = cat.name_ru; opt.dataset.slug = cat.slug;
      topSel.appendChild(opt);
      topSel.value = cat.id;
      populateSubcategories(cat.id, '');
      document.getElementById('pf-category-id').value = cat.id;
      closeCategoryModal();
    }).catch(function () { errEl.textContent = L.catFailed; errEl.hidden = false; });
  };

  // --- "+ Новая подкатегория" modal ---
  window.openSubcategoryModal = function () {
    var parentSel = document.getElementById('pf-newsub-parent');
    var currentTop = document.getElementById('pf-category').value;
    parentSel.innerHTML = '';
    tree.forEach(function (c) {
      var opt = document.createElement('option');
      opt.value = c.ID; opt.textContent = c.Name;
      if (c.ID === currentTop) opt.selected = true;
      parentSel.appendChild(opt);
    });
    if (!tree.length) { openCategoryModal(); return; } // nothing to nest under yet
    document.getElementById('pf-newsub-name').value = '';
    document.getElementById('pf-newsub-error').hidden = true;
    document.getElementById('pf-subcategory-modal').style.display = 'flex';
    document.getElementById('pf-newsub-name').focus();
  };
  window.closeSubcategoryModal = function () { document.getElementById('pf-subcategory-modal').style.display = 'none'; };

  window.pfSaveSubcategory = function () {
    var topID = document.getElementById('pf-newsub-parent').value;
    var nameRu = document.getElementById('pf-newsub-name').value.trim();
    var errEl = document.getElementById('pf-newsub-error');
    if (!nameRu) { errEl.textContent = L.enterName; errEl.hidden = false; return; }

    fetch('/admin/api/categories', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ parent_id: topID, name_ru: nameRu, name_ky: nameRu, slug: slugify(nameRu), sort_order: 0 })
    }).then(function (r) {
      if (!r.ok) throw new Error('save failed');
      return r.json();
    }).then(function (cat) {
      var top = null;
      for (var i = 0; i < tree.length; i++) { if (tree[i].ID === topID) top = tree[i]; }
      if (top) { top.Children = top.Children || []; top.Children.push({ ID: cat.id, Name: cat.name_ru, Slug: cat.slug }); }
      document.getElementById('pf-category').value = topID;
      populateSubcategories(topID, cat.id);
      document.getElementById('pf-category-id').value = cat.id;
      closeSubcategoryModal();
    }).catch(function () { errEl.textContent = L.subFailed; errEl.hidden = false; });
  };

  // --- "+ Новая" brand modal — brand is a free-text column on products,
  // not its own table (see catalog.ProductInput.Brand), so there's
  // nothing to POST: this just fills the Бренд field the same way
  // picking a datalist suggestion would. ---
  window.openBrandModal = function () {
    document.getElementById('pf-newbrand-name').value = '';
    document.getElementById('pf-brand-modal').style.display = 'flex';
    document.getElementById('pf-newbrand-name').focus();
  };
  window.closeBrandModal = function () { document.getElementById('pf-brand-modal').style.display = 'none'; };

  window.pfSaveBrand = function () {
    var name = document.getElementById('pf-newbrand-name').value.trim();
    if (!name) return;
    document.getElementById('pf-brand').value = name;
    closeBrandModal();
  };

  // --- variants ---
  // Each row carries one stock input per point of sale (see
  // product_form_parse.go for the qty_<key>_<pointID> / orig_<key>_<pointID>
  // contract); the badge shows the row's total across every point.
  var stockPoints = [];
  try { stockPoints = JSON.parse(document.getElementById('pf-stock-points').textContent || '[]') || []; } catch (e) { stockPoints = []; }

  window.pfUpdateBadge = function (input) {
    var row = input.closest('tr');
    var qty = 0;
    row.querySelectorAll('.admin-variant-input--qty').forEach(function (el) {
      var n = parseInt(el.value, 10);
      if (n > 0) qty += n;
    });
    var badge = row.querySelector('.admin-variant-badge');
    var label, fg, bg;
    if (qty === 0) { label = L.outOfStock; fg = '#C62828'; bg = '#FFEBEE'; }
    else if (qty < 5) { label = L.pcs.replace('%d', qty); fg = '#B85C00'; bg = '#FFF3E0'; }
    else { label = L.pcs.replace('%d', qty); fg = '#2E7D32'; bg = '#E8F5E9'; }
    badge.textContent = label;
    badge.style.color = fg;
    badge.style.background = bg;
  };

  function el(tag, attrs) {
    var node = document.createElement(tag);
    Object.keys(attrs || {}).forEach(function (k) { node.setAttribute(k, attrs[k]); });
    return node;
  }

  var newRowSeq = 0;
  window.pfAddVariant = function () {
    newRowSeq++;
    var key = 'n' + Date.now().toString(36) + newRowSeq;
    var tbody = document.getElementById('pf-variant-rows');
    var tr = el('tr', { 'class': 'admin-variant-row', 'data-key': key });

    var tdSize = el('td');
    tdSize.appendChild(el('input', { type: 'hidden', name: 'variant_key', value: key }));
    tdSize.appendChild(el('input', { type: 'hidden', name: 'variant_id', value: '' }));
    tdSize.appendChild(el('input', { type: 'text', name: 'variant_size', 'class': 'admin-variant-input', placeholder: '42', 'aria-label': L.size }));
    tr.appendChild(tdSize);

    var tdColor = el('td');
    tdColor.appendChild(el('input', { type: 'text', name: 'variant_color', 'class': 'admin-variant-input', placeholder: L.colorPlaceholder, 'aria-label': L.color }));
    tr.appendChild(tdColor);

    var tdPhoto = el('td');
    tdPhoto.innerHTML = '<button type="button" class="admin-variant-photo-btn" onclick="pfOpenColorPhotos(this)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"></path><circle cx="12" cy="13" r="3.2"></circle></svg><span class="admin-variant-photo-count">0</span></button>';
    tdPhoto.firstChild.setAttribute('aria-label', L.thisColorPhotos);
    tr.appendChild(tdPhoto);

    stockPoints.forEach(function (p) {
      var td = el('td');
      var input = el('input', {
        type: 'number', min: '0', max: '100000', step: '1', inputmode: 'numeric',
        name: 'qty_' + key + '_' + p.ID, value: '0',
        'class': 'admin-variant-input admin-variant-input--qty',
        'aria-label': L.stock + ': ' + p.Name
      });
      input.addEventListener('input', function () { pfUpdateBadge(input); });
      td.appendChild(input);
      tr.appendChild(td);
    });

    var tdBadge = el('td');
    tdBadge.innerHTML = '<span class="admin-chip admin-variant-badge" style="color:#C62828;background:#FFEBEE"></span>';
    tdBadge.firstChild.textContent = L.outOfStock;
    tr.appendChild(tdBadge);

    var tdRemove = el('td');
    tdRemove.innerHTML = '<button type="button" class="admin-variant-remove" onclick="pfRemoveVariantRow(this)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>';
    tdRemove.firstChild.setAttribute('aria-label', L.removeVariant);
    tr.appendChild(tdRemove);

    tbody.appendChild(tr);
    tr.querySelector('input[name="variant_size"]').focus();
  };

  window.pfRemoveVariantRow = function (btn) {
    btn.closest('tr').remove();
    pfPruneOrphanColorPhotos();
    syncHiddenInputs();
    pfRefreshPhotoBadges();
  };

  // --- photos: uploaded to POST /admin/api/media/upload, which
  // normalizes them server-side (white 1:1 square, full + thumb variants)
  // and returns the object key; a hidden image_object_key/image_color pair
  // of inputs then records each photo for the form submit. `photos` is the single source of truth (both the general
  // grid and every per-color modal read/write it) — color === '' is a
  // general product photo, any other value ties the photo to that exact
  // variant color text (see catalog.ImageRepo.ForColor server-side).
  // Preview shows the normalized thumb the server returns (thumb_url) —
  // i.e. exactly what the shop will show, white background included —
  // or the server-resolved thumb URL for a photo the product already had.
  var MAX_SLOTS = 6;
  var slotsEl = document.getElementById('pf-photo-slots');
  var inputsEl = document.getElementById('pf-image-inputs');
  var currentModalColor = '';

  var photos = [];
  try {
    var initialImages = JSON.parse(document.getElementById('pf-initial-images').textContent || '[]');
    photos = initialImages.map(function (img) {
      return { objectKey: img.ObjectKey, color: img.Color || '', url: img.URL };
    });
  } catch (e) { photos = []; }

  function syncHiddenInputs() {
    inputsEl.innerHTML = '';
    photos.forEach(function (p) {
      var keyInput = document.createElement('input');
      keyInput.type = 'hidden';
      keyInput.name = 'image_object_key';
      keyInput.value = p.objectKey;
      keyInput.setAttribute('form', 'product-form');
      inputsEl.appendChild(keyInput);

      var colorInput = document.createElement('input');
      colorInput.type = 'hidden';
      colorInput.name = 'image_color';
      colorInput.value = p.color || '';
      colorInput.setAttribute('form', 'product-form');
      inputsEl.appendChild(colorInput);
    });
  }

  // pfPruneOrphanColorPhotos drops color-tagged photos whose color no
  // longer matches any variant row still on the form — e.g. the row was
  // deleted, or its color text was retyped to something else — so a
  // removed/renamed color's photos don't keep being submitted and stored
  // against a color no variant actually has.
  function pfPruneOrphanColorPhotos() {
    var liveColors = {};
    document.querySelectorAll('input[name="variant_color"]').forEach(function (input) {
      var c = (input.value || '').trim();
      if (c) liveColors[c] = true;
    });
    photos = photos.filter(function (p) { return !p.color || liveColors[p.color]; });
  }

  function pfRefreshPhotoBadges() {
    document.querySelectorAll('.admin-variant-row').forEach(function (row) {
      var colorInput = row.querySelector('input[name="variant_color"]');
      var color = colorInput ? (colorInput.value || '').trim() : '';
      var count = color ? photos.filter(function (p) { return p.color === color; }).length : 0;
      var countEl = row.querySelector('.admin-variant-photo-count');
      if (countEl) countEl.textContent = count;
      var btn = row.querySelector('.admin-variant-photo-btn');
      if (btn) btn.classList.toggle('has-photos', count > 0);
    });
  }

  // Delegated listener (rather than one per row) so it keeps working for
  // rows pfAddVariant creates after page load.
  document.getElementById('pf-variant-rows').addEventListener('input', function (evt) {
    if (evt.target && evt.target.name === 'variant_color') { pfRefreshPhotoBadges(); }
  });

  document.getElementById('product-form').addEventListener('submit', function () {
    pfPruneOrphanColorPhotos();
    syncHiddenInputs();
  });

  function renderSlots() {
    slotsEl.innerHTML = '';
    var general = photos.filter(function (p) { return !p.color; });
    general.forEach(function (p, i) {
      var slot = document.createElement('div');
      slot.className = 'admin-photo-slot';
      var img = document.createElement('img');
      img.src = p.url;
      slot.appendChild(img);
      if (i === 0) {
        var main = document.createElement('span');
        main.className = 'admin-photo-slot__main';
        main.textContent = L.mainPhoto;
        slot.appendChild(main);
      }
      var rm = document.createElement('button');
      rm.type = 'button';
      rm.className = 'admin-photo-slot__remove';
      rm.innerHTML = '&times;';
      rm.onclick = function () {
        photos = photos.filter(function (x) { return x !== p; });
        renderSlots();
        syncHiddenInputs();
      };
      slot.appendChild(rm);
      slotsEl.appendChild(slot);
    });
  }
  renderSlots();
  syncHiddenInputs();
  pfRefreshPhotoBadges();

  window.pfPickPhoto = function () {
    var count = photos.filter(function (p) { return !p.color; }).length;
    if (count >= MAX_SLOTS) { alert(L.maxPhotos.replace('%d', MAX_SLOTS)); return; }
    document.getElementById('pf-file-input').click();
  };

  var MAX_UPLOAD_BYTES = 10 * 1024 * 1024;

  // uploadPhoto sends the file as multipart/form-data (field "file"). The
  // server decides whether it is a usable image (real format, size,
  // resolution); its 400 message is Russian and meant for the user, so
  // it's surfaced as is. Anything else (network, 5xx, expired session)
  // gets the generic message. The error's .message is what alert() shows.
  function uploadPhoto(file) {
    if (file.size > MAX_UPLOAD_BYTES) {
      return Promise.reject(new Error(L.fileTooBig));
    }
    var body = new FormData();
    body.append('file', file);
    return fetch('/admin/api/media/upload', { method: 'POST', body: body }).catch(function () {
      throw new Error(L.uploadOffline);
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (data) {
        if (r.status === 400 && data.message) throw new Error(data.message);
        if (!r.ok || !data.object_key) throw new Error(L.uploadFailed);
        return { objectKey: data.object_key, url: data.thumb_url };
      });
    });
  }

  function uploadFailed(err) {
    alert((err && err.message) || L.uploadFailed);
  }

  window.pfFileChosen = function (evt) {
    var file = evt.target.files[0];
    evt.target.value = '';
    if (!file) return;
    uploadPhoto(file).then(function (uploaded) {
      photos.push({ objectKey: uploaded.objectKey, color: '', url: uploaded.url });
      renderSlots();
      syncHiddenInputs();
    }).catch(uploadFailed);
  };

  // --- per-color photo modal, opened from a variant row's "Фото цвета"
  // button ---
  function renderColorModalGrid() {
    var grid = document.getElementById('pf-colorphoto-grid');
    grid.innerHTML = '';
    photos.filter(function (p) { return p.color === currentModalColor; }).forEach(function (p) {
      var slot = document.createElement('div');
      slot.className = 'admin-photo-slot';
      var img = document.createElement('img');
      img.src = p.url;
      slot.appendChild(img);
      var rm = document.createElement('button');
      rm.type = 'button';
      rm.className = 'admin-photo-slot__remove';
      rm.innerHTML = '&times;';
      rm.onclick = function () {
        photos = photos.filter(function (x) { return x !== p; });
        renderColorModalGrid();
        syncHiddenInputs();
        pfRefreshPhotoBadges();
      };
      slot.appendChild(rm);
      grid.appendChild(slot);
    });
  }

  window.pfOpenColorPhotos = function (btnEl) {
    var row = btnEl.closest('tr');
    var colorInput = row.querySelector('input[name="variant_color"]');
    var color = (colorInput.value || '').trim();
    if (!color) { alert(L.colorFirst); return; }
    currentModalColor = color;
    document.getElementById('pf-colorphoto-title').textContent = L.colorPhotosOf.replace('%s', color);
    renderColorModalGrid();
    document.getElementById('pf-colorphoto-modal').style.display = 'flex';
  };
  window.closeColorPhotoModal = function () {
    document.getElementById('pf-colorphoto-modal').style.display = 'none';
    syncHiddenInputs();
    pfRefreshPhotoBadges();
  };

  window.pfPickColorPhoto = function () {
    document.getElementById('pf-colorphoto-file-input').click();
  };

  window.pfColorFileChosen = function (evt) {
    var file = evt.target.files[0];
    evt.target.value = '';
    if (!file) return;
    uploadPhoto(file).then(function (uploaded) {
      photos.push({ objectKey: uploaded.objectKey, color: currentModalColor, url: uploaded.url });
      renderColorModalGrid();
      syncHiddenInputs();
    }).catch(uploadFailed);
  };
})();
</script>
{{end}}
{{end}}
