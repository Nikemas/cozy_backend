{{/* order_detail.gohtml — Заказ detail (Cozy Admin.dc.html lines 499-556):
     header (number + status chip), покупатель/доставка cards, состав
     заказа + итого, status-change buttons. Data is internal/admin/
     orders.go's OrderDetailData. New screen added to render.go's
     screenPages (Task 3) — not in the sidebar (internal/admin/nav.go's
     navDefs), reached only by clicking a row on orders.gohtml. */}}
{{define "content"}}
<div class="admin-order-detail">
  <div class="admin-card admin-card--pad admin-order-detail__header">
    <div>
      <div class="admin-order-detail__title">{{tf "admin.order.title" .Data.Number}}</div>
      <div class="admin-order-detail__date">{{.Data.DateLabel}}</div>
    </div>
    <div class="admin-order-detail__chips">
      <span class="admin-chip {{.Data.StatusClass}}">{{.Data.StatusLabel}}</span>
      {{if .Data.AwaitingPayment}}<span class="admin-chip admin-chip--awaiting-pay" title="{{t "admin.order.awaiting_payment_hint"}}">{{t "admin.order.awaiting_payment"}}</span>{{end}}
    </div>
  </div>

  <div class="admin-order-detail__grid">
    <div class="admin-card admin-card--pad">
      <div class="admin-order-detail__label">{{t "admin.orders.col_customer"}}</div>
      {{if .Data.CustomerName}}<div class="admin-order-detail__name">{{.Data.CustomerName}}</div>{{end}}
      {{with .Data.Contact}}{{if .Tel}}
      <a class="admin-order-detail__value admin-order-detail__phone" href="{{.Tel}}">{{.Display}}</a>
      <div class="admin-order-detail__contact">
        <a class="admin-btn admin-btn--secondary admin-btn--row" href="{{.Tel}}">{{t "admin.order.call"}}</a>
        <a class="admin-btn admin-btn--secondary admin-btn--row" href="{{.WhatsApp}}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <button type="button" class="admin-btn admin-btn--secondary admin-btn--row" data-copy="{{.Raw}}">{{t "admin.common.copy"}}</button>
      </div>
      {{end}}{{else}}
      <div class="admin-order-detail__value">{{.Data.Phone}}</div>
      {{end}}
      <div class="admin-order-detail__sub">{{.Data.PaymentLabel}}</div>
    </div>
    <div class="admin-card admin-card--pad">
      <div class="admin-order-detail__label">{{t "admin.order.delivery"}}</div>
      <div class="admin-order-detail__address">{{.Data.AddressText}}</div>
      {{if .Data.MapURL}}<a class="admin-btn admin-btn--secondary admin-btn--row admin-order-detail__map" href="{{.Data.MapURL}}" target="_blank" rel="noopener noreferrer">{{t "admin.order.on_map"}}</a>{{end}}
      {{if .Data.ZoneName}}<div class="admin-order-detail__sub">{{t "admin.order.zone"}}: {{.Data.ZoneName}}</div>{{end}}
      <div class="admin-order-detail__sub">{{t "admin.order.comment"}}: {{.Data.Comment}}</div>
    </div>
  </div>

  <div class="admin-card admin-order-detail__items">
    <div class="admin-order-detail__items-title">{{t "admin.order.items"}}</div>
    <table>
      <tbody>
        {{range .Data.Items}}
        <tr>
          <td class="admin-order-detail__thumb">{{if .ThumbURL}}<img class="admin-order-detail__thumb-box" src="{{.ThumbURL}}" alt="" width="52" height="52" loading="lazy">{{else}}<div class="admin-order-detail__thumb-box"></div>{{end}}</td>
          <td>
            <div class="admin-order-detail__item-name">{{.Name}}</div>
            <div class="admin-order-detail__item-variant">{{.Variant}}</div>
          </td>
          <td class="admin-order-detail__item-qty">{{.Qty}}</td>
          <td class="admin-order-detail__item-price">{{.PriceLabel}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{if .Data.DeliveryFeeLabel}}
    <div class="admin-order-detail__total">
      <span>{{t "admin.order.delivery"}}</span>
      <span>{{.Data.DeliveryFeeLabel}}</span>
    </div>
    {{end}}
    <div class="admin-order-detail__total">
      <span>{{t "admin.order.total"}}</span>
      <span class="admin-order-detail__total-sum">{{.Data.TotalLabel}}</span>
    </div>
  </div>

  {{/* История статусов + флаг возврата — блок fix/orders-integrity. */}}
  {{if .Data.RefundRequired}}
  <div class="admin-card admin-card--pad admin-order-detail__refund" role="alert">
    <div class="admin-order-detail__label">{{t "admin.order.refund_title"}}</div>
    <div class="admin-order-detail__sub">{{t "admin.order.refund_text"}}</div>
  </div>
  {{end}}
  {{if .Data.History}}
  <div class="admin-card admin-card--pad admin-order-detail__history">
    <div class="admin-order-detail__label">{{t "admin.order.history"}}</div>
    <table class="admin-order-detail__history-table">
      <tbody>
        {{range .Data.History}}
        <tr>
          <td class="admin-order-detail__history-date">{{.DateLabel}}</td>
          <td class="admin-order-detail__history-status">{{if .FromLabel}}{{.FromLabel}} → {{end}}{{.ToLabel}}</td>
          <td class="admin-order-detail__history-actor">{{.Actor}}</td>
          <td class="admin-order-detail__history-note">{{.Note}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}

  {{/* On a phone this card sticks to the bottom of the screen
       (admin.css), so the next status is one tap away without scrolling
       past the items and history. */}}
  {{if .Data.StatusButtons}}
  <div class="admin-card admin-card--pad admin-order-detail__actions">
    <div class="admin-order-detail__label">{{t "admin.order.change_status"}}</div>
    <div class="admin-order-detail__statusbtns">
      {{range .Data.StatusButtons}}
      <form method="post" action="/admin/orders/{{$.Data.ID}}/status"{{if eq .Value "cancelled"}}
            data-confirm="{{tf "admin.order.cancel_confirm_text" $.Data.Number}}" data-confirm-title="{{t "admin.order.cancel_confirm_title"}}"
            data-confirm-label="{{t "admin.order.cancel_confirm_label"}}" data-confirm-danger="1"{{else if eq .Value "delivered"}}
            data-confirm="{{tf "admin.order.delivered_confirm_text" $.Data.Number}}" data-confirm-title="{{t "admin.order.delivered_confirm_title"}}"
            data-confirm-label="{{t "admin.order.delivered_confirm_label"}}"{{end}}>
        <input type="hidden" name="status" value="{{.Value}}">
        <button type="submit" class="admin-status-btn {{.Class}}">{{.Label}}</button>
      </form>
      {{end}}
    </div>
  </div>
  {{end}}
</div>
{{end}}
