{{/* product_import.gohtml — Товары: импорт (Cozy Admin.dc.html lines
     376-403). PageData.Data is a *admin.ImportPageData built by
     productImportPage (products.go). The page's own JS talks to the JSON
     endpoints in internal/httpapi/admin_import.go:
       POST <ImportURL>           — file + dry_run + point_id -> report
       GET  <ImportURL>/points    — stock target choices
       GET  <ImportURL>/template  — the .xlsx template (plain link)
     Flow: choose file -> «Проверить» (dry run, nothing written) ->
     «Импортировать». */}}
{{define "content"}}
{{with .Data}}
<style>
  #import-result:not([hidden]) { display: flex; flex-direction: column; gap: 16px; }
  .admin-import__file { font-size: 13px; color: var(--admin-text); }
  .admin-import__controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 16px; }
  .admin-import__controls .admin-field { margin-bottom: 0; min-width: 240px; flex: 1; }
  .admin-import__buttons { display: flex; gap: 8px; flex-wrap: wrap; }
  .admin-import__notice { background: #FFF8E1; border: 1px solid #F3E2B3; border-radius: var(--admin-radius-card); padding: 14px 18px; font-size: 14px; color: #6D5200; }
  .admin-import__summary { font-size: 13px; font-weight: 500; margin-top: 6px; color: var(--admin-text); }
  .admin-import__report { max-height: 480px; overflow: auto; }
  .admin-import__report .admin-table { min-width: 0; }
  .admin-import__status--created { color: #2E7D32; font-weight: 600; }
  .admin-import__status--updated { color: #1565C0; font-weight: 600; }
  .admin-import__status--skipped { color: #8A8A85; font-weight: 600; }
  .admin-import__status--error { color: #C62828; font-weight: 600; }
</style>
<div class="admin-import">
  <div class="admin-card admin-card--pad">
    <div class="admin-import__dropzone" id="import-dropzone">
      <div class="admin-import__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5"></path></svg>
      </div>
      <div class="admin-import__title">Перетащите Excel или CSV файл сюда</div>
      <div class="admin-table__muted">или</div>
      <button type="button" class="admin-btn admin-btn--secondary" onclick="document.getElementById('import-file-input').click()">Выберите файл</button>
      <input type="file" id="import-file-input" accept=".csv,.xlsx" style="display:none">
      <div class="admin-import__file" id="import-file-name" aria-live="polite"></div>
      <a class="admin-linkbtn" href="{{.ImportURL}}/template" download>Скачать шаблон</a>
    </div>

    <div class="admin-import__controls">
      <div class="admin-field">
        <label for="import-point">Точка продаж для колонки «Остаток»</label>
        <select id="import-point" name="point_id">
          <option value="">Загрузка…</option>
        </select>
      </div>
      <div class="admin-import__buttons">
        <button type="button" class="admin-btn admin-btn--secondary" id="import-check" disabled>Проверить</button>
        <button type="button" class="admin-btn admin-btn--primary" id="import-run" disabled>Импортировать</button>
      </div>
    </div>
  </div>

  <div id="import-result" hidden>
    <div id="import-banner"></div>
    <div class="admin-card admin-card--pad" id="import-errors-card" hidden>
      <div class="admin-import__errors-title" id="import-errors-title"></div>
      <div id="import-errors-list"></div>
    </div>
    <div class="admin-card admin-import__report" id="import-report-card" hidden>
      <table class="admin-table">
        <thead>
          <tr><th>Строка</th><th>Статус</th><th>Модель</th><th>Размер</th><th>Цвет</th><th>SKU</th><th>Причина</th></tr>
        </thead>
        <tbody id="import-report-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function () {
  var importURL = {{.ImportURL}};
  var dropzone = document.getElementById('import-dropzone');
  var fileInput = document.getElementById('import-file-input');
  var fileNameEl = document.getElementById('import-file-name');
  var pointSelect = document.getElementById('import-point');
  var checkBtn = document.getElementById('import-check');
  var runBtn = document.getElementById('import-run');
  var resultEl = document.getElementById('import-result');
  var bannerEl = document.getElementById('import-banner');
  var errorsCard = document.getElementById('import-errors-card');
  var errorsTitle = document.getElementById('import-errors-title');
  var errorsList = document.getElementById('import-errors-list');
  var reportCard = document.getElementById('import-report-card');
  var reportBody = document.getElementById('import-report-body');

  var chosenFile = null;
  var checkedOK = false; // last dry run of this file/point had no errors
  var busy = false;

  function pluralRu(n, one, few, many) {
    var a = Math.abs(n) % 100, b = a % 10;
    if (a > 10 && a < 20) return many;
    if (b > 1 && b < 5) return few;
    if (b === 1) return one;
    return many;
  }

  function setBusy(v) {
    busy = v;
    checkBtn.disabled = v || !chosenFile;
    runBtn.disabled = v || !chosenFile;
    dropzone.style.opacity = v ? '0.6' : '1';
  }

  function chooseFile(file) {
    if (!file) return;
    chosenFile = file;
    checkedOK = false;
    fileNameEl.textContent = 'Файл: ' + file.name;
    resultEl.hidden = true;
    setBusy(false);
  }

  fetch(importURL + '/points', { credentials: 'same-origin' })
    .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
    .then(function (res) {
      pointSelect.innerHTML = '';
      var points = res.points || [];
      if (!points.length) {
        var none = document.createElement('option');
        none.value = '';
        none.textContent = 'Нет активных точек — остатки не загружаются';
        pointSelect.appendChild(none);
        return;
      }
      points.forEach(function (p) {
        var o = document.createElement('option');
        o.value = p.id;
        o.textContent = p.name + (p.address ? ' — ' + p.address : '');
        pointSelect.appendChild(o);
      });
    })
    .catch(function () {
      pointSelect.innerHTML = '';
      var o = document.createElement('option');
      o.value = '';
      o.textContent = 'Первая активная точка (по умолчанию)';
      pointSelect.appendChild(o);
    });
  pointSelect.addEventListener('change', function () { checkedOK = false; });

  var statusLabels = {
    created: ['создано', 'будет создано'],
    updated: ['обновлено', 'будет обновлено'],
    skipped: ['пропущено', 'будет пропущено'],
    error: ['ошибка', 'ошибка']
  };

  function cell(tr, text, cls) {
    var td = document.createElement('td');
    td.textContent = text == null ? '' : String(text);
    if (cls) td.className = cls;
    tr.appendChild(td);
  }

  function render(res) {
    var s = res.summary || {};
    var dry = !!res.dry_run;
    resultEl.hidden = false;

    bannerEl.className = (s.errors || s.skipped) ? 'admin-import__notice' : 'admin-import__success';
    bannerEl.textContent = '';
    var head = document.createElement('div');
    if (dry) {
      head.textContent = (s.errors || s.skipped)
        ? 'Проверка: есть ошибки. Ничего не записано — исправьте файл или импортируйте только корректные модели.'
        : 'Проверка пройдена, ничего не записано. Можно импортировать.';
    } else {
      var n = (s.products_created || 0) + (s.products_updated || 0);
      head.textContent = 'Импортировано: ' + n + ' ' + pluralRu(n, 'товар', 'товара', 'товаров');
    }
    bannerEl.appendChild(head);
    var line = document.createElement('div');
    line.className = 'admin-import__summary';
    line.textContent = 'Товары: создано ' + (s.products_created || 0) + ', обновлено ' + (s.products_updated || 0) +
      ' · Вариации: создано ' + (s.variants_created || 0) + ', обновлено ' + (s.variants_updated || 0) +
      ' · Строк: ' + (s.rows || 0) + ', с ошибками ' + (s.errors || 0) + ', пропущено ' + (s.skipped || 0);
    bannerEl.appendChild(line);

    var rows = res.rows || [];
    var bad = rows.filter(function (r) { return r.status === 'error' || r.status === 'skipped'; });
    errorsList.innerHTML = '';
    if (bad.length) {
      errorsCard.hidden = false;
      errorsTitle.textContent = (dry ? 'Не будет импортировано: ' : 'Не импортировано: ') + bad.length + ' ' + pluralRu(bad.length, 'строка', 'строки', 'строк');
      bad.forEach(function (r) {
        var div = document.createElement('div');
        div.className = 'admin-import__error-row';
        div.textContent = 'Строка ' + r.row + (r.model ? ' (' + r.model + ')' : '') + ' — ' + (r.message || r.status);
        errorsList.appendChild(div);
      });
    } else {
      errorsCard.hidden = true;
    }

    reportBody.innerHTML = '';
    rows.forEach(function (r) {
      var tr = document.createElement('tr');
      cell(tr, r.row);
      var lbl = statusLabels[r.status] || [r.status, r.status];
      cell(tr, dry ? lbl[1] : lbl[0], 'admin-import__status--' + r.status);
      cell(tr, r.model);
      cell(tr, r.size);
      cell(tr, r.color);
      cell(tr, r.sku);
      cell(tr, r.message, 'admin-table__muted');
      reportBody.appendChild(tr);
    });
    reportCard.hidden = rows.length === 0;
  }

  function send(dryRun) {
    if (!chosenFile || busy) return;
    if (!dryRun && !checkedOK && !confirm('Файл ещё не проверен без ошибок. Импортировать сейчас? Корректные модели будут записаны, модели с ошибками — пропущены.')) return;
    var form = new FormData();
    form.append('file', chosenFile);
    form.append('dry_run', dryRun ? '1' : '0');
    if (pointSelect.value) form.append('point_id', pointSelect.value);
    setBusy(true);
    fetch(importURL, { method: 'POST', body: form, credentials: 'same-origin' })
      .then(function (r) {
        if (!r.ok) {
          return r.json().catch(function () { return {}; }).then(function (e) {
            throw new Error((e && (e.message || (e.error && e.error.message))) || 'Ошибка импорта');
          });
        }
        return r.json();
      })
      .then(function (res) {
        setBusy(false);
        var s = res.summary || {};
        checkedOK = dryRun && !s.errors && !s.skipped;
        render(res);
      })
      .catch(function (err) {
        setBusy(false);
        alert(err.message || 'Не удалось выполнить импорт');
      });
  }

  checkBtn.addEventListener('click', function () { send(true); });
  runBtn.addEventListener('click', function () { send(false); });
  fileInput.addEventListener('change', function (e) { chooseFile(e.target.files[0]); });

  ['dragenter', 'dragover'].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.add('dragover'); });
  });
  ['dragleave', 'drop'].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.remove('dragover'); });
  });
  dropzone.addEventListener('drop', function (e) {
    chooseFile(e.dataTransfer.files && e.dataTransfer.files[0]);
  });
})();
</script>
{{end}}
{{end}}
