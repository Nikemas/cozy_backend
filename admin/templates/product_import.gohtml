{{/* product_import.gohtml — Товары: импорт (Cozy Admin.dc.html lines
     376-403). PageData.Data is an admin.ImportPageData; handlers in
     internal/admin/product_import.go. Server-rendered htmx flow:
       POST <CheckURL>  — file + point_id, dry run -> report + run button
       POST <ApplyURL>  — same form + checked_token -> real import
       GET  <ResetURL>  — another file/point chosen -> run button disabled
       GET  <ImportURL>/template — the .xlsx template (plain link)
     «Импортировать» is rendered disabled until a check of that exact file
     came back clean; the check response swaps the enabled button in
     (hx-swap-oob). Without JS the check form posts normally and the whole
     page comes back with the report, but the run slot stays hidden (the
     page script reveals it once htmx has loaded) and a <noscript> notice
     says importing needs JavaScript: a full-page reply can't keep the
     chosen file, so an apply could never succeed. A 429 (per-staff rate
     limit) is swapped into the report like any other reply. */}}
{{define "content"}}
{{with .Data}}
<style>
  #import-result { display: flex; flex-direction: column; gap: 16px; }
  .admin-import__file { font-size: 13px; color: var(--admin-text); }
  .admin-import__controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 16px; }
  .admin-import__controls .admin-field { margin-bottom: 0; min-width: 240px; flex: 1; }
  .admin-import__buttons { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  #import-run-slot { display: contents; }
  #import-run-slot[hidden] { display: none; }
  .admin-import__hint { font-size: 12px; color: var(--admin-muted); flex-basis: 100%; }
  .admin-import__busy { font-size: 13px; color: var(--admin-muted); display: none; }
  .htmx-request .admin-import__busy, .admin-import__busy.htmx-request { display: inline; }
  .admin-import__notice { background: #FFF8E1; border: 1px solid #F3E2B3; border-radius: var(--admin-radius-card); padding: 14px 18px; font-size: 14px; color: #6D5200; }
  .admin-import__summary { font-size: 13px; font-weight: 500; margin-top: 6px; color: var(--admin-text); }
  .admin-import__report { max-height: 480px; overflow: auto; }
  .admin-import__report .admin-table { min-width: 0; }
  /* td-qualified: .admin-table td's own colour used to win. */
  .admin-import__report td.admin-import__status--created { color: #2E7D32; font-weight: 600; }
  .admin-import__report td.admin-import__status--updated { color: #1565C0; font-weight: 600; }
  .admin-import__report td.admin-import__status--skipped { color: #8A8A85; font-weight: 600; }
  .admin-import__report td.admin-import__status--error { color: #C62828; font-weight: 600; }
  .admin-import__report td { white-space: nowrap; }
  .admin-import__report td:last-child { white-space: normal; min-width: 220px; }
</style>
<div class="admin-import">
  <noscript><div class="admin-import__notice" role="note">{{t "admin.import.needs_js"}}</div></noscript>
  <form class="admin-card admin-card--pad" id="import-form" method="post" action="{{.CheckURL}}" enctype="multipart/form-data"
        hx-post="{{.CheckURL}}" hx-encoding="multipart/form-data" hx-target="#import-result" hx-swap="innerHTML" hx-indicator="#import-busy">
    <div class="admin-import__dropzone" id="import-dropzone">
      <div class="admin-import__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5"></path></svg>
      </div>
      <div class="admin-import__title">{{t "admin.import.drop"}}</div>
      <div class="admin-table__muted">{{t "admin.import.or"}}</div>
      <label class="admin-btn admin-btn--secondary" for="import-file-input">{{t "admin.import.choose"}}</label>
      <input type="file" id="import-file-input" name="file" accept=".csv,.xlsx" class="admin-visually-hidden">
      <div class="admin-import__file" id="import-file-name" aria-live="polite"></div>
      <a class="admin-linkbtn" href="{{.ImportURL}}/template" download>{{t "admin.import.template"}}</a>
    </div>

    <div class="admin-import__controls">
      <div class="admin-field">
        <label for="import-point">{{t "admin.import.point_label"}}</label>
        <select id="import-point" name="point_id">
          {{if .PointsFailed}}
          <option value="">{{t "admin.import.default_point"}}</option>
          {{else if not .Points}}
          <option value="">{{t "admin.import.no_points"}}</option>
          {{else}}
          {{$chosen := .PointID}}
          {{range .Points}}
          <option value="{{.ID}}"{{if eq .ID $chosen}} selected{{end}}>{{.Name}}{{if .Address}} — {{.Address}}{{end}}</option>
          {{end}}
          {{end}}
        </select>
      </div>
      <div class="admin-import__buttons">
        <button type="submit" class="admin-btn admin-btn--secondary" id="import-check">{{t "admin.import.check"}}</button>
        <span id="import-run-slot" hidden>{{template "import_run" .}}</span>
        <span class="admin-import__busy" id="import-busy" role="status">{{t "admin.import.working"}}</span>
      </div>
    </div>
  </form>

  {{/* Choosing another file or point drops the last check's state. */}}
  <div hidden hx-get="{{.ResetURL}}" hx-trigger="change from:#import-file-input, change from:#import-point" hx-target="#import-result" hx-swap="innerHTML"></div>

  <div id="import-result" aria-live="polite">{{template "import_result" .Result}}</div>
</div>

<script>
(function () {
  // Cosmetic only: the chosen file's name, and drag-and-drop onto the
  // zone. Enabling «Импортировать» is the server's job.
  var dropzone = document.getElementById('import-dropzone');
  var fileInput = document.getElementById('import-file-input');
  var fileNameEl = document.getElementById('import-file-name');
  var fileLabel = {{t "admin.import.file"}};
  function showName() {
    var f = fileInput.files && fileInput.files[0];
    fileNameEl.textContent = f ? fileLabel + ': ' + f.name : '';
  }
  fileInput.addEventListener('change', showName);
  ['dragenter', 'dragover'].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.add('dragover'); });
  });
  ['dragleave', 'drop'].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.remove('dragover'); });
  });
  // «Импортировать» needs htmx (it re-sends the chosen file with the
  // check's token), so it is only shown once htmx is there.
  document.addEventListener('DOMContentLoaded', function () {
    var slot = document.getElementById('import-run-slot');
    if (slot && window.htmx) { slot.hidden = false; }
  });
  // htmx doesn't swap error replies by default; the rate-limit reply
  // (429) carries the localized message for the report.
  document.addEventListener('htmx:beforeSwap', function (e) {
    if (e.detail.xhr && e.detail.xhr.status === 429 && e.detail.target && e.detail.target.id === 'import-result') {
      e.detail.shouldSwap = true;
      e.detail.isError = false;
    }
  });
  dropzone.addEventListener('drop', function (e) {
    if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
    fileInput.files = e.dataTransfer.files;
    fileInput.dispatchEvent(new Event('change', { bubbles: true }));
  });
})();
</script>
{{end}}
{{end}}

{{/* import_run: the «Импортировать» button's server-side state. */}}
{{define "import_run"}}
{{if .Run.Enabled}}<input type="hidden" name="checked_token" value="{{.Run.Token}}">{{end}}
<button type="submit" class="admin-btn admin-btn--primary" id="import-run" formaction="{{.ApplyURL}}" hx-post="{{.ApplyURL}}"{{if not .Run.Enabled}} disabled aria-describedby="import-run-hint"{{end}}>{{t "admin.import.run"}}</button>
{{if not .Run.Enabled}}<span class="admin-import__hint" id="import-run-hint">{{t "admin.import.run_hint"}}</span>{{end}}
{{end}}

{{/* import_response: an htmx reply — the report plus the run button. */}}
{{define "import_response"}}
{{template "import_result" .Result}}
<span id="import-run-slot" hx-swap-oob="true">{{template "import_run" .}}</span>
{{end}}

{{/* import_result: the report (.Result, nil before the first check). */}}
{{define "import_result"}}
{{with .}}
{{if .Error}}
<div class="admin-form-error" role="alert">{{.Error}}</div>
{{else}}
<div class="{{if .HasProblems}}admin-import__notice{{else}}admin-import__success{{end}}" role="status">
  <div>{{.Head}}</div>
  <div class="admin-import__summary">{{.Summary}}</div>
</div>
{{if .BadRows}}
<div class="admin-card admin-card--pad">
  <div class="admin-import__errors-title">{{.BadTitle}}</div>
  {{range .BadRows}}<div class="admin-import__error-row">{{.}}</div>{{end}}
</div>
{{end}}
{{if .Rows}}
<div class="admin-card admin-import__report">
  <table class="admin-table">
    <thead>
      <tr><th>{{t "admin.import.row"}}</th><th>{{t "admin.common.status"}}</th><th>{{t "admin.import.model"}}</th><th>{{t "admin.common.size"}}</th><th>{{t "admin.common.color"}}</th><th>SKU</th><th>{{t "admin.import.reason"}}</th></tr>
    </thead>
    <tbody>
      {{range .Rows}}
      <tr><td>{{.Row}}</td><td class="admin-import__status--{{.StatusClass}}">{{.StatusLabel}}</td><td>{{.Model}}</td><td>{{.Size}}</td><td>{{.Color}}</td><td>{{.SKU}}</td><td class="admin-table__muted">{{.Message}}</td></tr>
      {{end}}
    </tbody>
  </table>
</div>
{{end}}
{{end}}
{{end}}
{{end}}
