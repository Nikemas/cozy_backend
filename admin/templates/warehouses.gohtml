{{/* warehouses.gohtml — «Склады» (feat/warehouses): every warehouse
     (points_of_sale.kind = 'warehouse'), owner only — a storekeeper is
     redirected to its own warehouse's page. .Data is
     admin.warehousesPageData (internal/admin/warehouses_page.go). */}}
{{define "content"}}
<div class="admin-screen-narrow">
  <div class="admin-list-toolbar">
    <div class="admin-list-note">{{t "admin.warehouses.note"}}</div>
    {{if eq .Staff.Role "owner"}}<button type="button" class="admin-btn admin-btn--primary" onclick="openWarehouseModal()">+ {{t "admin.warehouses.add"}}</button>{{end}}
  </div>

  {{with .Data}}
  {{if .Error}}<div class="admin-form-error" role="alert">{{.Error}}</div>{{end}}

  <div class="admin-row-list">
    {{if not .Rows}}
      <div class="admin-row-list__empty">{{t "admin.warehouses.empty"}}</div>
    {{end}}
    {{range .Rows}}
    <div class="admin-row">
      <div class="admin-row__icon">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35a2 2 0 0 1 1.26-1.86l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35z M6 18h12 M6 14h12 M6 22V10h12v12"></path></svg>
      </div>
      <div class="admin-row__info">
        <div class="admin-row__title"><a href="{{.URL}}">{{.Name}}</a></div>
        <div class="admin-row__subtitle">{{.FullAddress}} · {{.LocationsLabel}}</div>
      </div>
      <span class="admin-chip {{.ChipClass}}">{{.ChipLabel}}</span>
      <a href="{{.URL}}" class="admin-btn admin-btn--secondary admin-btn--row">{{t "admin.warehouses.locations"}}</a>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--row"
              data-id="{{.ID}}" data-name="{{.Name}}" data-city="{{.City}}" data-address="{{.Address}}"
              onclick="openWarehouseModal(this)" aria-label="{{tf "admin.warehouses.edit_aria" .Name}}">{{t "admin.common.change"}}</button>
      <form method="post" action="{{.URL}}/toggle"{{if .IsActive}}
            data-confirm="{{tf "admin.warehouses.deactivate_text" .Name}}"
            data-confirm-title="{{t "admin.warehouses.deactivate_title"}}" data-confirm-label="{{t "admin.common.deactivate"}}" data-confirm-danger="1"{{end}}>
        <button type="submit" class="admin-btn admin-btn--secondary admin-btn--row">{{.ToggleLabel}}</button>
      </form>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="admin-row-list"><div class="admin-row-list__empty">{{t "admin.warehouses.empty"}}</div></div>
  {{end}}
</div>

{{template "_warehouse_modal" .}}
{{end}}

